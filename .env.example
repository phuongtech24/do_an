# ============================================
# ReConnect MindHealth - Environment Variables
# ============================================
# Copy this file to .env.local and fill in your values
# DO NOT commit .env or .env.local to git!

# ========== DATABASE ==========
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mindhealth_db
DB_USER=root
DB_PASSWORD=123456

# ========== SERVER ==========
SERVER_PORT=8081

# ========== SECURITY - JWT ==========
# Generate a strong secret (min 32 chars): openssl rand -base64 32
JWT_SECRET=mindhealth-local-secret-change-this-32chars-min
JWT_EXPIRATION_MS=86400000

# ========== SECURITY - ENCRYPTION ==========
# AES-128 encryption key (exactly 16 chars)
# Use: openssl rand -hex 16 | cut -c1-16
ENCRYPTION_KEY=ReconnectMindH78
# AES-128 IV (exactly 16 chars)
ENCRYPTION_IV=MindHealthIv1234

# ========== GEMINI AI ==========
AI_ENABLED=false
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_API_VERSION=v1beta
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TIMEOUT_MS=8000

# ========== AI BEHAVIOR CONFIG ==========
AI_RISK_CALL_AI_ONLY_WHEN_SUSPICIOUS=true
AI_RISK_AI_CALL_THRESHOLD=70
AI_DISTORTIONS_CALL_AI_ONLY_WHEN_SUSPICIOUS=true
AI_DISTORTIONS_MAX_SUGGESTIONS=3

# ========== FILE UPLOAD ==========
UPLOAD_DIR=uploads
QUEST_PROOF_DIR=proofs

# ========== FLUTTER/WEB API BASE URL ==========
# For local development
API_BASE_URL=http://localhost:8081/api
