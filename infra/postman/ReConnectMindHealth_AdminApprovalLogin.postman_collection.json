{
  "info": {
    "_postman_id": "b6d1b4e6-6b2a-4d9a-9d7a-8e2a3c2e7c01",
    "name": "ReConnect MindHealth - Admin / Approval / Login (Quick Demo)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (Admin) -> set jwtAdmin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "if (body && body.data && body.data.token) {",
                  "  pm.environment.set('jwtAdmin', body.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "Login (Therapist) -> set jwtTherapist (ACTIVE only)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "if (body && body.data && body.data.token) {",
                  "  pm.environment.set('jwtTherapist', body.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{therapistEmail}}\",\n  \"password\": \"{{therapistPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Admin - Users",
      "item": [
        {
          "name": "List users",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwtAdmin}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "users"
              ]
            }
          }
        },
        {
          "name": "Set user active (need userId)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwtAdmin}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/users/{{userId}}/active?active=false",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "users",
                "{{userId}}",
                "active"
              ],
              "query": [
                {
                  "key": "active",
                  "value": "false"
                }
              ]
            }
          }
        },
        {
          "name": "Set user role (need userId)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwtAdmin}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/users/{{userId}}/role?role=THERAPIST",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "users",
                "{{userId}}",
                "role"
              ],
              "query": [
                {
                  "key": "role",
                  "value": "THERAPIST"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Admin - Therapist Approval",
      "item": [
        {
          "name": "Create therapist (PENDING) -> set therapistId",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "if (body && body.data && body.data.therapistId) {",
                  "  pm.environment.set('therapistId', body.data.therapistId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwtAdmin}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{therapistEmail}}\",\n  \"password\": \"{{therapistPassword}}\",\n  \"fullName\": \"{{therapistFullName}}\",\n  \"specialization\": \"{{therapistSpecialization}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/therapists/create",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "therapists",
                "create"
              ]
            }
          }
        },
        {
          "name": "List therapists (optional status filter)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwtAdmin}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/therapists?status=PENDING",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "therapists"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "PENDING"
                }
              ]
            }
          }
        },
        {
          "name": "Set approval ACTIVE (need therapistId)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwtAdmin}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/therapists/{{therapistId}}/approval?status=ACTIVE",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "therapists",
                "{{therapistId}}",
                "approval"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "ACTIVE"
                }
              ]
            }
          }
        },
        {
          "name": "Set approval REJECTED (need therapistId)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwtAdmin}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/therapists/{{therapistId}}/approval?status=REJECTED",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "therapists",
                "{{therapistId}}",
                "approval"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "REJECTED"
                }
              ]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ]
}

