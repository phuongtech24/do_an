              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"situation\": \"Mình bị sếp góp ý trước mọi người.\",\n  \"automaticThought\": \"Mình vô dụng.\",\n  \"emotion\": \"Buồn\",\n  \"emotionScore\": 75\n}"
            },
            "url": {
