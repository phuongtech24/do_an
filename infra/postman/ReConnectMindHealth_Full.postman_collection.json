    {
      "name": "04 - Journal (CBT)",
      "item": [
        {
          "name": "Create thought record -> set journalId",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "if (body && body.data && body.data.id) {",
                  "  pm.environment.set('journalId', body.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwtPatient}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patientId\": \"{{patientId}}\",\n  \"journalType\": \"THOUGHT_RECORD\",\n  \"situation\": \"Mình bị từ chối phỏng vấn.\",\n  \"automaticThought\": \"Mình kém cỏi.\",\n  \"emotion\": \"Buồn\",\n  \"emotionScore\": 70,\n  \"adaptiveResponse\": \"Có thể mình chưa phù hợp vị trí, mình vẫn có thể cải thiện.\",\n  \"reRatedScore\": 40\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/journal/thought-records",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "journal", "thought-records" ]
            }
          }
        },
        {
          "name": "List journals",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwtPatient}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/journal/thought-records?patientId={{patientId}}",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "journal", "thought-records" ],
              "query": [
                { "key": "patientId", "value": "{{patientId}}" }
              ]
            }
          }
        },
        {
          "name": "Get journal detail (need journalId)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwtPatient}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/journal/thought-records/{{journalId}}?patientId={{patientId}}",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "journal", "thought-records", "{{journalId}}" ],
              "query": [
                { "key": "patientId", "value": "{{patientId}}" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "05 - Roadmap",
      "item": [
        {
          "name": "Get daily quests -> set patientQuestId (first item)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "if (body && body.data && Array.isArray(body.data) && body.data.length > 0) {",
                  "  pm.environment.set('patientQuestId', body.data[0].id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwtPatient}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/roadmap/daily?patientId={{patientId}}",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "roadmap", "daily" ],
              "query": [
                { "key": "patientId", "value": "{{patientId}}" }
              ]
            }
          }
        },
        {
          "name": "Complete quest (need patientQuestId)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwtPatient}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"masteryScore\": 7,\n  \"pleasureScore\": 6\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/roadmap/quests/{{patientQuestId}}/complete?patientId={{patientId}}",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "roadmap", "quests", "{{patientQuestId}}", "complete" ],
              "query": [
                { "key": "patientId", "value": "{{patientId}}" }
              ]
            }
          }
        },
        {
          "name": "Verify proof image (choose file manually)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwtPatient}}" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "patientId", "value": "{{patientId}}", "type": "text" },
                { "key": "file", "type": "file", "src": [] }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/roadmap/quests/{{patientQuestId}}/proof/verify?patientId={{patientId}}",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "roadmap", "quests", "{{patientQuestId}}", "proof", "verify" ],
              "query": [
                { "key": "patientId", "value": "{{patientId}}" }
              ]
            }
          }
        }
      ]
    },
