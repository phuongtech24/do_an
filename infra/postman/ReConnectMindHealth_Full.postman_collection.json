{
  "info": {
    "_postman_id": "0b7b4f8b-3a72-4b4a-8b2e-6b0d1b28f92a",
    "name": "ReConnect MindHealth - FULL (Quick End-to-End Demo)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00 - Auth",
      "item": [
        {
          "name": "Login (Admin) -> set jwtAdmin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "if (body && body.data && body.data.token) {",
                  "  pm.environment.set('jwtAdmin', body.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "auth", "login" ]
            }
          }
        },
        {
          "name": "Login (Patient) -> set jwtPatient + patientId",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "if (body && body.data && body.data.token) {",
                  "  pm.environment.set('jwtPatient', body.data.token);",
                  "}",
                  "if (body && body.data && body.data.user && body.data.user.id) {",
                  "  pm.environment.set('patientId', body.data.user.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{patientEmail}}\",\n  \"password\": \"{{patientPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "auth", "login" ]
            }
          }
        },
        {
          "name": "Register Anonymous (deviceId) -> set jwtPatient + patientId",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "if (body && body.data && body.data.token) {",
                  "  pm.environment.set('jwtPatient', body.data.token);",
                  "}",
                  "if (body && body.data && body.data.user && body.data.user.id) {",
                  "  pm.environment.set('patientId', body.data.user.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/auth/register-anonymous?deviceId={{deviceId}}",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "auth", "register-anonymous" ],
              "query": [
                { "key": "deviceId", "value": "{{deviceId}}" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "01 - Clinical (Onboarding)",
      "item": [
        {
          "name": "Get onboarding status",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwtPatient}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/clinical/onboarding-status?patientId={{patientId}}",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "clinical", "onboarding-status" ],
              "query": [
                { "key": "patientId", "value": "{{patientId}}" }
              ]
            }
          }
        },
        {
          "name": "Save goals (3-5 goals)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwtPatient}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patientId\": \"{{patientId}}\",\n  \"goals\": [\n    \"Đi bộ 10 phút mỗi ngày\",\n    \"Ngủ trước 23:00\",\n    \"Gặp 1 người bạn trong tuần\"\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/clinical/goals",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "clinical", "goals" ]
            }
          }
        },
        {
          "name": "Get goals",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwtPatient}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/clinical/goals?patientId={{patientId}}",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "clinical", "goals" ],
              "query": [
                { "key": "patientId", "value": "{{patientId}}" }
              ]
            }
          }
        },
        {
          "name": "Complete psychoeducation",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwtPatient}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/clinical/psychoeducation/complete?patientId={{patientId}}",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "clinical", "psychoeducation", "complete" ],
              "query": [
                { "key": "patientId", "value": "{{patientId}}" }
              ]
            }
          }
        }
      ]
