spring:
  application:
    name: reconnect_backend
  datasource:
    url: jdbc:mysql://${DB_HOST:localhost}:${DB_PORT:3306}/${DB_NAME:mindhealth_db}?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
    username: ${DB_USER:mindhealth_user}
    password: ${DB_PASSWORD:mindhealth_password}
  jpa:
    hibernate:
      ddl-auto: update
    show-sql: true
    properties:
      hibernate:
        format_sql: true
        dialect: org.hibernate.dialect.MySQLDialect

server:
  port: 8080
  error:
    include-message: always
    include-binding-errors: always

app:
  security:
    jwt-secret: ${JWT_SECRET:replace-this-secret}
  ai:
    enabled: ${AI_ENABLED:true}
    gemini:
      api-key: ${GEMINI_API_KEY:replace-this-key}
      base-url: ${GEMINI_BASE_URL:https://generativelanguage.googleapis.com}
      api-version: ${GEMINI_API_VERSION:v1beta}
      model: ${GEMINI_MODEL:gemini-1.5-flash}
    risk:
      call-ai-only-when-suspicious: ${AI_RISK_CALL_AI_ONLY_WHEN_SUSPICIOUS:true}
      ai-call-threshold: ${AI_RISK_AI_CALL_THRESHOLD:70}
    distortions:
      call-ai-only-when-suspicious: ${AI_DISTORTIONS_CALL_AI_ONLY_WHEN_SUSPICIOUS:true}
      max-suggestions: ${AI_DISTORTIONS_MAX_SUGGESTIONS:3}
