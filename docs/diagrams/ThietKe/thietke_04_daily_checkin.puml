@startuml
skinparam defaultFontName "Times New Roman"
title Biểu đồ lớp thiết kế — Package DailyCheckin

interface ICheckinService {
  +submitCheckin(req: CheckinRequestDto): CheckinResultDto
  +getHistory(patientId: UUID, days: Integer): List<CheckinResultDto>
  +evaluateSafetyGate(moodId: UUID): SafetyGateResultDto
  +respondToSafetyGate(moodId: UUID, response: String): SafetyGateResultDto
}

class CheckinController {
  -checkinService: ICheckinService
  +submitCheckin(req: CheckinRequestDto): ResponseEntity
  +getHistory(patientId: UUID, days: Integer): ResponseEntity
  +respondSafetyGate(moodId: UUID, req: SafetyGateResponseDto): ResponseEntity
}

class CheckinServiceImpl {
  -userMoodRepository: IUserMoodRepository
  -patientProfileRepository: IPatientProfileRepository
  +submitCheckin(req: CheckinRequestDto): CheckinResultDto
  +evaluateSafetyGate(mood: UserMood): SafetyGateResultDto
  +getRoutingRecommendation(mood: UserMood): String
  +activateRedFlag(patientId: UUID): void
}

interface IUserMoodRepository {
  +save(mood: UserMood): UserMood
  +findLatestByPatientId(id: UUID): Optional<UserMood>
  +findByPatientIdAndDateRange(id: UUID, from: LocalDate, to: LocalDate): List<UserMood>
}

class UserMoodRepository

class CheckinRequestDto {
  +patientId: UUID
  +anxietyScore: Integer
  +avoidanceUrgeScore: Integer
  +sadnessScore: Integer
  +anticipatoryAnxietyScore: Integer
  +ruminationScore: Integer
}

class CheckinResultDto {
  +moodId: UUID
  +requiresSafetyGate: Boolean
  +routingRecommendation: String
  +recordedAt: LocalDateTime
}

class SafetyGateResultDto {
  +isUnsafe: Boolean
  +redFlagActivated: Boolean
  +nextStep: String
  +emergencyMessage: String
}

class SafetyGateResponseDto {
  +response: String
}

CheckinController --> ICheckinService : uses
CheckinServiceImpl ..|> ICheckinService : implements
CheckinServiceImpl --> IUserMoodRepository : uses
UserMoodRepository ..|> IUserMoodRepository : implements
CheckinController ..> CheckinRequestDto : uses
CheckinController ..> CheckinResultDto : returns
CheckinController ..> SafetyGateResultDto : returns

@enduml
