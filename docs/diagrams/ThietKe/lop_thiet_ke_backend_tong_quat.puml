@startuml
skinparam defaultFontName "Times New Roman"
title Biểu đồ lớp thiết kế chi tiết Backend - ReConnect MindHealth

' ===================== AUTH =====================
package "Auth" {
  interface IAuthService {
    +login(req: LoginRequestDto): LoginResponseDto
    +registerGuest(req: GuestRegisterDto): GuestResponseDto
    +convertGuestToPatient(req: ConversionRequestDto): LoginResponseDto
    +refreshToken(token: String): LoginResponseDto
  }

  class AuthController {
    -authService: IAuthService
    +login(req: LoginRequestDto): ResponseEntity
    +registerGuest(req: GuestRegisterDto): ResponseEntity
    +convertGuestToPatient(req: ConversionRequestDto): ResponseEntity
  }

  class AuthServiceImpl {
    -userRepository: IUserRepository
    -jwtService: JwtService
    -passwordEncoder: PasswordEncoder
    +login(req: LoginRequestDto): LoginResponseDto
    +convertGuestToPatient(req: ConversionRequestDto): LoginResponseDto
  }

  class JwtService {
    -jwtSecret: String
    -jwtExpirationMs: long
    +generateToken(user: User): String
    +extractUsername(token: String): String
    +isTokenValid(token: String, user: User): Boolean
  }

  interface IUserRepository {
    +findByEmail(email: String): Optional<User>
    +existsByEmail(email: String): Boolean
    +save(user: User): User
  }

  class UserRepository

  class LoginRequestDto {
    +email: String
    +password: String
  }

  class LoginResponseDto {
    +accessToken: String
    +role: String
    +userId: UUID
    +onboardingStep: String
  }

  class ConversionRequestDto {
    +email: String
    +password: String
    +realFullName: String
    +phoneNumber: String
  }

  AuthController --> IAuthService : uses
  AuthServiceImpl ..|> IAuthService : implements
  AuthServiceImpl --> JwtService : uses
  AuthServiceImpl --> IUserRepository : uses
  UserRepository ..|> IUserRepository : implements
  AuthController ..> LoginRequestDto : uses
  AuthController ..> LoginResponseDto : returns
}

' ===================== GUEST =====================
package "GuestManagement" {
  interface IGuestService {
    +createGuestSession(): GuestProfileDto
    +getGuestProfile(id: UUID): GuestProfileDto
    +updateNickname(id: UUID, nickname: String): void
  }

  class GuestController {
    -guestService: IGuestService
    +createSession(): ResponseEntity
    +updateNickname(id: UUID, req: NicknameDto): ResponseEntity
  }

  class GuestServiceImpl {
    -guestProfileRepository: IGuestProfileRepository
    +createGuestSession(): GuestProfileDto
    +updateNickname(id: UUID, nickname: String): void
  }

  interface IGuestProfileRepository {
    +save(guest: GuestProfile): GuestProfile
    +findById(id: UUID): Optional<GuestProfile>
    +markConverted(id: UUID): void
  }

  class GuestProfileRepository

  class GuestProfileDto {
    +id: UUID
    +nickname: String
    +avatarIcon: String
    +convertedToPatient: Boolean
  }

  GuestController --> IGuestService : uses
  GuestServiceImpl ..|> IGuestService : implements
  GuestServiceImpl --> IGuestProfileRepository : uses
  GuestProfileRepository ..|> IGuestProfileRepository : implements
  GuestController ..> GuestProfileDto : returns
}

' ===================== ASSESSMENT =====================
package "Assessment" {
  interface IAssessmentService {
    +getSituations(): List<LsasSituationDto>
    +submitLsas(req: LsasSubmitDto): LsasResultDto
    +getLatestResult(patientId: UUID): LsasResultDto
    +getHistory(patientId: UUID): List<LsasResultDto>
  }

  class AssessmentController {
    -assessmentService: IAssessmentService
    +getSituations(): ResponseEntity
    +submitLsas(req: LsasSubmitDto): ResponseEntity
    +getResult(patientId: UUID): ResponseEntity
  }

  class AssessmentServiceImpl {
    -lsasSubmissionRepository: ILsasSubmissionRepository
    -lsasAnswerRepository: ILsasAnswerRepository
    -lsasSituationRepository: ILsasSituationRepository
    -patientProfileRepository: IPatientProfileRepository
    +submitLsas(req: LsasSubmitDto): LsasResultDto
    +computeRoute(totalScore: Integer): ClinicalRoute
  }

  interface ILsasSubmissionRepository {
    +save(s: LsasSubmission): LsasSubmission
    +findLatestByPatientId(id: UUID): Optional<LsasSubmission>
    +findAllByPatientId(id: UUID): List<LsasSubmission>
  }

  class LsasSubmissionRepository
  class LsasAnswerRepository
  class LsasSituationRepository

  class LsasSubmitDto {
    +patientId: UUID
    +submissionType: String
    +answers: List<AnswerItemDto>
  }

  class LsasResultDto {
    +totalScore: Integer
    +fearTotal: Integer
    +avoidanceTotal: Integer
    +severityBand: String
    +clinicalRoute: String
  }

  AssessmentController --> IAssessmentService : uses
  AssessmentServiceImpl ..|> IAssessmentService : implements
  AssessmentServiceImpl --> ILsasSubmissionRepository : uses
  LsasSubmissionRepository ..|> ILsasSubmissionRepository : implements
  AssessmentController ..> LsasSubmitDto : uses
  AssessmentController ..> LsasResultDto : returns
}

' ===================== DAILY CHECK-IN =====================
package "DailyCheckin" {
  interface ICheckinService {
    +submitCheckin(req: CheckinRequestDto): CheckinResultDto
    +getHistory(patientId: UUID, days: Integer): List<CheckinResultDto>
    +evaluateSafetyGate(moodId: UUID): SafetyGateResultDto
  }

  class CheckinController {
    -checkinService: ICheckinService
    +submitCheckin(req: CheckinRequestDto): ResponseEntity
    +getHistory(patientId: UUID): ResponseEntity
  }

  class CheckinServiceImpl {
    -userMoodRepository: IUserMoodRepository
    -patientProfileRepository: IPatientProfileRepository
    +submitCheckin(req: CheckinRequestDto): CheckinResultDto
    +evaluateSafetyGate(mood: UserMood): SafetyGateResultDto
    +getRoutingRecommendation(mood: UserMood): String
  }

  interface IUserMoodRepository {
    +save(mood: UserMood): UserMood
    +findLatestByPatientId(id: UUID): Optional<UserMood>
    +findByPatientIdAndDateRange(id: UUID, from: LocalDate, to: LocalDate): List<UserMood>
  }

  class UserMoodRepository

  class CheckinRequestDto {
    +patientId: UUID
    +anxietyScore: Integer
    +avoidanceUrgeScore: Integer
    +sadnessScore: Integer
    +anticipatoryAnxietyScore: Integer
    +ruminationScore: Integer
  }

  class CheckinResultDto {
    +moodId: UUID
    +requiresSafetyGate: Boolean
    +routingRecommendation: String
  }

  class SafetyGateResultDto {
    +isUnsafe: Boolean
    +redFlagActivated: Boolean
    +nextStep: String
  }

  CheckinController --> ICheckinService : uses
  CheckinServiceImpl ..|> ICheckinService : implements
  CheckinServiceImpl --> IUserMoodRepository : uses
  UserMoodRepository ..|> IUserMoodRepository : implements
  CheckinController ..> CheckinRequestDto : uses
  CheckinController ..> CheckinResultDto : returns
}

' ===================== ROADMAP =====================
package "Roadmap" {
  interface IFearLadderService {
    +generateLadder(patientId: UUID): List<FearLadderItemDto>
    +getLadder(patientId: UUID): List<FearLadderItemDto>
    +unlockNext(itemId: UUID): void
  }

  interface IBehavioralExperimentService {
    +createExperiment(req: ExperimentRequestDto): ExperimentDto
    +completeExperiment(id: UUID, req: DebriefDto): ExperimentDto
    +getExperimentsByPatient(patientId: UUID): List<ExperimentDto>
  }

  class RoadmapController {
    -fearLadderService: IFearLadderService
    +getLadder(patientId: UUID): ResponseEntity
    +unlockNextItem(itemId: UUID): ResponseEntity
  }

  class FearLadderController {
    -fearLadderService: IFearLadderService
    +generateLadder(patientId: UUID): ResponseEntity
  }

  class BehavioralExperimentController {
    -experimentService: IBehavioralExperimentService
    +createExperiment(req: ExperimentRequestDto): ResponseEntity
    +completeExperiment(id: UUID, req: DebriefDto): ResponseEntity
  }

  class FearLadderServiceImpl {
    -fearLadderItemRepository: IFearLadderItemRepository
    -lsasSubmissionRepository: ILsasSubmissionRepository
    -patientGoalRepository: IPatientGoalRepository
    +generateLadder(patientId: UUID): List<FearLadderItemDto>
    +sortAndBucket(items: List<FearLadderItem>): List<FearLadderItem>
  }

  class BehavioralExperimentServiceImpl {
    -experimentRepository: IBehavioralExperimentRepository
    -fearLadderItemRepository: IFearLadderItemRepository
    +createExperiment(req: ExperimentRequestDto): ExperimentDto
    +completeExperiment(id: UUID, req: DebriefDto): ExperimentDto
  }

  interface IFearLadderItemRepository {
    +save(item: FearLadderItem): FearLadderItem
    +findByPatientId(id: UUID): List<FearLadderItem>
    +findUnlockedByPatientId(id: UUID): List<FearLadderItem>
  }

  interface IBehavioralExperimentRepository {
    +save(exp: BehavioralExperiment): BehavioralExperiment
    +findRecentByPatientId(id: UUID, limit: Integer): List<BehavioralExperiment>
  }

  interface IPatientGoalRepository {
    +save(goal: PatientGoal): PatientGoal
    +findByPatientId(id: UUID): List<PatientGoal>
  }

  class FearLadderItemRepository
  class BehavioralExperimentRepository
  class PatientGoalRepository

  RoadmapController --> IFearLadderService : uses
  FearLadderController --> IFearLadderService : uses
  BehavioralExperimentController --> IBehavioralExperimentService : uses
  FearLadderServiceImpl ..|> IFearLadderService : implements
  BehavioralExperimentServiceImpl ..|> IBehavioralExperimentService : implements
  FearLadderServiceImpl --> IFearLadderItemRepository : uses
  BehavioralExperimentServiceImpl --> IBehavioralExperimentRepository : uses
  FearLadderItemRepository ..|> IFearLadderItemRepository : implements
  BehavioralExperimentRepository ..|> IBehavioralExperimentRepository : implements
  PatientGoalRepository ..|> IPatientGoalRepository : implements
}

' ===================== JOURNAL & AI =====================
package "Journal & AI" {
  interface IJournalService {
    +createJournal(req: JournalRequestDto): JournalDto
    +getJournalsByPatient(patientId: UUID): List<JournalDto>
    +analyzeRisk(journalId: UUID): RiskAnalysisDto
  }

  interface IAiAssistantService {
    +generateResponse(message: String, context: String): String
    +analyzeSentiment(text: String): SentimentResultDto
    +suggestCognitiveErrors(text: String): List<String>
  }

  class JournalController {
    -journalService: IJournalService
    +createJournal(req: JournalRequestDto): ResponseEntity
    +getJournals(patientId: UUID): ResponseEntity
  }

  class AiController {
    -aiAssistantService: IAiAssistantService
    +chat(req: AiChatRequestDto): ResponseEntity
    +analyzeThoughtRecord(req: JournalRequestDto): ResponseEntity
  }

  class JournalServiceImpl {
    -journalRepository: IJournalRepository
    -aiAssistantService: IAiAssistantService
    -patientProfileRepository: IPatientProfileRepository
    +createJournal(req: JournalRequestDto): JournalDto
    +analyzeRisk(journalId: UUID): RiskAnalysisDto
  }

  class GeminiAiAssistantServiceImpl {
    -geminiApiKey: String
    -geminiEndpoint: String
    +generateResponse(message: String, context: String): String
    +analyzeSentiment(text: String): SentimentResultDto
    +suggestCognitiveErrors(text: String): List<String>
  }

  class AiChatController {
    -aiChatService: IAiChatService
    +startSession(patientId: UUID): ResponseEntity
    +sendMessage(sessionId: UUID, req: ChatMessageDto): ResponseEntity
    +getHistory(sessionId: UUID): ResponseEntity
  }

  interface IAiChatService {
    +startSession(patientId: UUID): AiChatSessionDto
    +sendMessage(sessionId: UUID, content: String): AiChatMessageDto
    +getHistory(sessionId: UUID): List<AiChatMessageDto>
    +submitFeedback(messageId: UUID, isHelpful: Boolean): void
  }

  class AiChatServiceImpl {
    -aiChatSessionRepository: IAiChatSessionRepository
    -aiChatMessageRepository: IAiChatMessageRepository
    -aiChatFeedbackRepository: IAiChatFeedbackRepository
    -aiAssistantService: IAiAssistantService
    +startSession(patientId: UUID): AiChatSessionDto
    +sendMessage(sessionId: UUID, content: String): AiChatMessageDto
  }

  interface IJournalRepository {
    +save(journal: Journal): Journal
    +findByPatientId(id: UUID): List<Journal>
    +findHighRiskByPatientId(id: UUID): List<Journal>
  }

  interface IAiChatSessionRepository {
    +save(session: AiChatSession): AiChatSession
    +findByPatientId(id: UUID): List<AiChatSession>
  }

  interface IAiChatMessageRepository {
    +save(msg: AiChatMessage): AiChatMessage
    +findBySessionId(id: UUID): List<AiChatMessage>
  }

  interface IAiChatFeedbackRepository {
    +save(fb: AiChatFeedback): AiChatFeedback
  }

  class JournalRepository
  class AiChatSessionRepository
  class AiChatMessageRepository
  class AiChatFeedbackRepository

  JournalController --> IJournalService : uses
  AiController --> IAiAssistantService : uses
  AiChatController --> IAiChatService : uses
  JournalServiceImpl ..|> IJournalService : implements
  GeminiAiAssistantServiceImpl ..|> IAiAssistantService : implements
  AiChatServiceImpl ..|> IAiChatService : implements
  JournalServiceImpl --> IJournalRepository : uses
  JournalServiceImpl --> IAiAssistantService : uses
  AiChatServiceImpl --> IAiChatSessionRepository : uses
  AiChatServiceImpl --> IAiChatMessageRepository : uses
  AiChatServiceImpl --> IAiAssistantService : uses
  JournalRepository ..|> IJournalRepository : implements
  AiChatSessionRepository ..|> IAiChatSessionRepository : implements
  AiChatMessageRepository ..|> IAiChatMessageRepository : implements
  AiChatFeedbackRepository ..|> IAiChatFeedbackRepository : implements
}

' ===================== TELEHEALTH =====================
package "Telehealth" {
  interface IBookingService {
    +getAvailableSlots(therapistId: UUID, date: LocalDate): List<SlotDto>
    +bookAppointment(req: BookingRequestDto): AppointmentDto
    +cancelAppointment(id: UUID): void
    +getAppointmentsByPatient(patientId: UUID): List<AppointmentDto>
  }

  class BoosterController {
    -bookingService: IBookingService
    +getAvailableSlots(therapistId: UUID, date: LocalDate): ResponseEntity
    +bookAppointment(req: BookingRequestDto): ResponseEntity
    +cancelAppointment(id: UUID): ResponseEntity
  }

  class BoosterServiceImpl {
    -appointmentRepository: IAppointmentRepository
    -scheduleSlotRepository: IScheduleSlotRepository
    -weeklyScheduleRepository: IWeeklyScheduleRepository
    +getAvailableSlots(therapistId: UUID, date: LocalDate): List<SlotDto>
    +bookAppointment(req: BookingRequestDto): AppointmentDto
    +cancelAppointment(id: UUID): void
  }

  interface IAppointmentRepository {
    +save(a: Appointment): Appointment
    +findByPatientId(id: UUID): List<Appointment>
    +findByTherapistId(id: UUID): List<Appointment>
    +findUpcomingByPatientId(id: UUID): List<Appointment>
  }

  interface IScheduleSlotRepository {
    +findAvailableByTherapistAndDate(tid: UUID, date: LocalDate): List<TherapistScheduleSlot>
    +save(slot: TherapistScheduleSlot): TherapistScheduleSlot
    +markBooked(slotId: UUID): void
  }

  interface IWeeklyScheduleRepository {
    +findByTherapistId(id: UUID): List<TherapistWeeklyScheduleSlot>
    +save(slot: TherapistWeeklyScheduleSlot): TherapistWeeklyScheduleSlot
  }

  class AppointmentRepository
  class TherapistScheduleSlotRepository
  class TherapistWeeklyScheduleSlotRepository

  class BookingRequestDto {
    +patientId: UUID
    +therapistId: UUID
    +slotId: UUID
    +durationMinutes: Integer
    +purpose: String
  }

  class AppointmentDto {
    +id: UUID
    +startAt: LocalDateTime
    +endAt: LocalDateTime
    +status: String
    +purpose: String
    +meetingLink: String
  }

  BoosterController --> IBookingService : uses
  BoosterServiceImpl ..|> IBookingService : implements
  BoosterServiceImpl --> IAppointmentRepository : uses
  BoosterServiceImpl --> IScheduleSlotRepository : uses
  BoosterServiceImpl --> IWeeklyScheduleRepository : uses
  AppointmentRepository ..|> IAppointmentRepository : implements
  TherapistScheduleSlotRepository ..|> IScheduleSlotRepository : implements
  TherapistWeeklyScheduleSlotRepository ..|> IWeeklyScheduleRepository : implements
  BoosterController ..> BookingRequestDto : uses
  BoosterController ..> AppointmentDto : returns
}

' ===================== CLINICAL =====================
package "Clinical" {
  interface IClinicalTriageService {
    +getRedFlagPatients(): List<PatientSummaryDto>
    +activateRedFlag(patientId: UUID): void
    +overrideTherapistAssignment(patientId: UUID, therapistId: UUID): void
    +getPreSessionReview(patientId: UUID): PreSessionReviewDto
  }

  class TherapistDashboardController {
    -clinicalTriageService: IClinicalTriageService
    +getMyPatients(): ResponseEntity
    +getRedFlagPatients(): ResponseEntity
    +getPreSessionReview(patientId: UUID): ResponseEntity
  }

  class AdminDemoControlController {
    -adminDemoControlService: IAdminDemoControlService
    +overrideTherapist(patientId: UUID, therapistId: UUID): ResponseEntity
    +listTherapists(): ResponseEntity
    +approveCredential(credentialId: UUID): ResponseEntity
  }

  class ClinicalTriageServiceImpl {
    -patientProfileRepository: IPatientProfileRepository
    -therapistProfileRepository: ITherapistProfileRepository
    -therapistCredentialRepository: ITherapistCredentialRepository
    +getRedFlagPatients(): List<PatientSummaryDto>
    +activateRedFlag(patientId: UUID): void
    +overrideTherapistAssignment(patientId: UUID, therapistId: UUID): void
  }

  interface IAdminDemoControlService {
    +listAllTherapists(): List<TherapistSummaryDto>
    +approveCredential(credentialId: UUID): void
    +rejectCredential(credentialId: UUID): void
  }

  class AdminDemoControlServiceImpl {
    -therapistProfileRepository: ITherapistProfileRepository
    -therapistCredentialRepository: ITherapistCredentialRepository
    +listAllTherapists(): List<TherapistSummaryDto>
    +approveCredential(credentialId: UUID): void
  }

  interface IPatientProfileRepository {
    +findById(id: UUID): Optional<PatientProfile>
    +findByTherapistId(id: UUID): List<PatientProfile>
    +findRedFlagActive(): List<PatientProfile>
    +save(p: PatientProfile): PatientProfile
  }

  interface ITherapistProfileRepository {
    +findById(id: UUID): Optional<TherapistProfile>
    +findAllActive(): List<TherapistProfile>
    +save(t: TherapistProfile): TherapistProfile
  }

  interface ITherapistCredentialRepository {
    +save(c: TherapistCredential): TherapistCredential
    +findByTherapistId(id: UUID): List<TherapistCredential>
    +findPending(): List<TherapistCredential>
  }

  class PatientProfileRepository
  class TherapistProfileRepository
  class TherapistCredentialRepository

  class PreSessionReviewDto {
    +patientId: UUID
    +lsasBaseline: Integer
    +lsasCurrent: Integer
    +recentJournals: List<JournalDto>
    +recentMoods: List<CheckinResultDto>
    +fearLadderSnapshot: List<FearLadderItemDto>
    +recentExperiments: List<ExperimentDto>
    +upcomingAppointment: AppointmentDto
    +isRedFlagActive: Boolean
  }

  TherapistDashboardController --> IClinicalTriageService : uses
  AdminDemoControlController --> IAdminDemoControlService : uses
  ClinicalTriageServiceImpl ..|> IClinicalTriageService : implements
  AdminDemoControlServiceImpl ..|> IAdminDemoControlService : implements
  ClinicalTriageServiceImpl --> IPatientProfileRepository : uses
  ClinicalTriageServiceImpl --> ITherapistProfileRepository : uses
  ClinicalTriageServiceImpl --> ITherapistCredentialRepository : uses
  PatientProfileRepository ..|> IPatientProfileRepository : implements
  TherapistProfileRepository ..|> ITherapistProfileRepository : implements
  TherapistCredentialRepository ..|> ITherapistCredentialRepository : implements
  TherapistDashboardController ..> PreSessionReviewDto : returns
}

' ===================== CROSS-PACKAGE DEPENDENCIES =====================
"Auth" ..> "Clinical" : IPatientProfileRepository
"Roadmap" ..> "Assessment" : ILsasSubmissionRepository
"Journal & AI" ..> "Clinical" : IPatientProfileRepository
"DailyCheckin" ..> "Clinical" : IPatientProfileRepository
"Telehealth" ..> "Clinical" : IPatientProfileRepository, ITherapistProfileRepository
"Clinical" ..> "Journal & AI" : IJournalRepository (pre-session)
"Clinical" ..> "Assessment" : ILsasSubmissionRepository (pre-session)

@enduml
