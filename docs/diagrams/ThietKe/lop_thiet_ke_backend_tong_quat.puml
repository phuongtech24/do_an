package "Auth" {
  class AuthController
  class AuthServiceImpl
  class UserRepository
  class JwtService
  class User
  class LoginRequestDto
  class LoginResponseDto

  AuthController --> AuthServiceImpl
  AuthServiceImpl --> UserRepository
  AuthServiceImpl --> JwtService
