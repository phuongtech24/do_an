@startuml
skinparam defaultFontName "Times New Roman"
title Biểu đồ lớp thiết kế — Package Auth

interface IAuthService {
  +login(req: LoginRequestDto): LoginResponseDto
  +registerGuest(req: GuestRegisterDto): GuestResponseDto
  +convertGuestToPatient(req: ConversionRequestDto): LoginResponseDto
  +refreshToken(token: String): LoginResponseDto
}

class AuthController {
  -authService: IAuthService
  +login(req: LoginRequestDto): ResponseEntity
  +registerGuest(req: GuestRegisterDto): ResponseEntity
  +convertGuestToPatient(req: ConversionRequestDto): ResponseEntity
}

class AuthServiceImpl {
  -userRepository: IUserRepository
  -jwtService: JwtService
  -passwordEncoder: PasswordEncoder
  +login(req: LoginRequestDto): LoginResponseDto
  +convertGuestToPatient(req: ConversionRequestDto): LoginResponseDto
}

class JwtService {
  -jwtSecret: String
  -jwtExpirationMs: long
  +generateToken(user: User): String
  +extractUsername(token: String): String
  +isTokenValid(token: String, user: User): Boolean
}

interface IUserRepository {
  +findByEmail(email: String): Optional<User>
  +existsByEmail(email: String): Boolean
  +save(user: User): User
}

class UserRepository

class LoginRequestDto {
  +email: String
  +password: String
}

class LoginResponseDto {
  +accessToken: String
  +role: String
  +userId: UUID
  +onboardingStep: String
}

class ConversionRequestDto {
  +email: String
  +password: String
  +realFullName: String
  +phoneNumber: String
}

AuthController --> IAuthService : uses
AuthServiceImpl ..|> IAuthService : implements
AuthServiceImpl --> JwtService : uses
AuthServiceImpl --> IUserRepository : uses
UserRepository ..|> IUserRepository : implements
AuthController ..> LoginRequestDto : uses
AuthController ..> LoginResponseDto : returns

@enduml
