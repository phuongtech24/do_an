@startuml
skinparam defaultFontName "Times New Roman"
title Biểu đồ lớp thiết kế — Package Roadmap (Fear Ladder & Behavioral Experiment)

interface IFearLadderService {
  +generateLadder(patientId: UUID): List<FearLadderItemDto>
  +getLadder(patientId: UUID): List<FearLadderItemDto>
  +unlockNext(itemId: UUID): void
}

interface IBehavioralExperimentService {
  +createExperiment(req: ExperimentRequestDto): ExperimentDto
  +completeExperiment(id: UUID, req: DebriefDto): ExperimentDto
  +getExperimentsByPatient(patientId: UUID): List<ExperimentDto>
}

interface IPatientGoalService {
  +setGoal(req: GoalRequestDto): PatientGoalDto
  +getGoals(patientId: UUID): List<PatientGoalDto>
}

class RoadmapController {
  -fearLadderService: IFearLadderService
  +getLadder(patientId: UUID): ResponseEntity
  +unlockNextItem(itemId: UUID): ResponseEntity
}

class FearLadderController {
  -fearLadderService: IFearLadderService
  +generateLadder(patientId: UUID): ResponseEntity
}

class BehavioralExperimentController {
  -experimentService: IBehavioralExperimentService
  +createExperiment(req: ExperimentRequestDto): ResponseEntity
  +completeExperiment(id: UUID, req: DebriefDto): ResponseEntity
  +listExperiments(patientId: UUID): ResponseEntity
}

class FearLadderServiceImpl {
  -fearLadderItemRepository: IFearLadderItemRepository
  -lsasSubmissionRepository: ILsasSubmissionRepository
  -patientGoalRepository: IPatientGoalRepository
  +generateLadder(patientId: UUID): List<FearLadderItemDto>
  +sortAndBucket(items: List): List<FearLadderItem>
}

class BehavioralExperimentServiceImpl {
  -experimentRepository: IBehavioralExperimentRepository
  -fearLadderItemRepository: IFearLadderItemRepository
  +createExperiment(req: ExperimentRequestDto): ExperimentDto
  +completeExperiment(id: UUID, req: DebriefDto): ExperimentDto
}

class PatientGoalServiceImpl {
  -patientGoalRepository: IPatientGoalRepository
  +setGoal(req: GoalRequestDto): PatientGoalDto
  +getGoals(patientId: UUID): List<PatientGoalDto>
}

interface IFearLadderItemRepository {
  +save(item: FearLadderItem): FearLadderItem
  +findByPatientId(id: UUID): List<FearLadderItem>
  +findUnlockedByPatientId(id: UUID): List<FearLadderItem>
}

interface IBehavioralExperimentRepository {
  +save(exp: BehavioralExperiment): BehavioralExperiment
  +findRecentByPatientId(id: UUID, limit: Integer): List<BehavioralExperiment>
}

interface IPatientGoalRepository {
  +save(goal: PatientGoal): PatientGoal
  +findByPatientId(id: UUID): List<PatientGoal>
}

class FearLadderItemRepository
class BehavioralExperimentRepository
class PatientGoalRepository

class FearLadderItemDto {
  +id: UUID
  +situationText: String
  +bucket: String
  +ladderOrder: Integer
  +status: String
  +baselineTotalScore: Integer
  +currentTotalScore: Integer
}

class ExperimentRequestDto {
  +fearLadderItemId: UUID
  +patientId: UUID
  +prediction: String
  +predictionBeliefBefore: Integer
  +safeBehaviorToDrop: String
  +sourceType: String
}

class DebriefDto {
  +outcome: String
  +learning: String
  +debriefNote: String
  +predictionBeliefAfter: Integer
}

RoadmapController --> IFearLadderService : uses
FearLadderController --> IFearLadderService : uses
BehavioralExperimentController --> IBehavioralExperimentService : uses
FearLadderServiceImpl ..|> IFearLadderService : implements
BehavioralExperimentServiceImpl ..|> IBehavioralExperimentService : implements
PatientGoalServiceImpl ..|> IPatientGoalService : implements
FearLadderServiceImpl --> IFearLadderItemRepository : uses
BehavioralExperimentServiceImpl --> IBehavioralExperimentRepository : uses
FearLadderItemRepository ..|> IFearLadderItemRepository : implements
BehavioralExperimentRepository ..|> IBehavioralExperimentRepository : implements
PatientGoalRepository ..|> IPatientGoalRepository : implements

@enduml
