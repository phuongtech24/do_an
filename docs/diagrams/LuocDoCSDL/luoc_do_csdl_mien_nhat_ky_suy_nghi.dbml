Project ReConnectMindHealth_ThoughtRecordDomain {
  database_type: "MySQL"
  Note: "Lược đồ CSDL miền nhật ký suy nghĩ và hỗ trợ AI"
}

Table patient_profiles {
  user_id uuid [pk]
  nickname varchar(255)
  current_risk_score int
}

Table journals {
  id uuid [pk]
  patient_id uuid [not null, ref: > patient_profiles.user_id]
  journal_type varchar(32)
  title varchar(255)
  situation text
  automatic_thought text
  emotion_summary text
  ai_risk_score int
  severity_level varchar(50)
  created_at datetime
}
