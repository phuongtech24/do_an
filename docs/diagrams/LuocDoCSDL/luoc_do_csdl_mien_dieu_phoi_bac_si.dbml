Project ReConnectMindHealth_TherapistMatchingDomain {
  database_type: "MySQL"
  Note: "Lược đồ CSDL miền điều phối và ghép cặp bệnh nhân - bác sĩ"
}

Table therapist_profiles {
  user_id uuid [pk]
  full_name varchar(255)
  specialization varchar(255)
  region varchar(255)
  approval_status varchar(32)
  current_caseload int
}

Table patient_profiles {
  user_id uuid [pk]
  therapist_id uuid [ref: > therapist_profiles.user_id]
  nickname varchar(255)
  triage_required bool
  triage_status varchar(50)
  triage_priority int
  triage_triggered_at datetime
  current_lsas_score int
  current_risk_score int
  is_red_flag_active bool
}
