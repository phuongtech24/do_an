Project ReConnectMindHealth_Core19 {
  database_type: "MySQL"
  Note: "Lược đồ CSDL tổng quát chuẩn hiện tại: 16 bảng lõi + 3 bảng AI chat = 19 bảng"
}

Table users {
  id uuid [pk]
  role varchar(32) [note: "GUEST | PATIENT | THERAPIST | ADMIN"]
  email varchar(255)
  is_active boolean
  is_anonymous boolean
}

Table guest_profiles {
  id uuid [pk]
  user_id uuid [ref: > users.id]
}

Table therapist_profiles {
  user_id uuid [pk, ref: > users.id]
  approval_status varchar(32) [note: "PENDING | ACTIVE | REJECTED"]
}

Table patient_profiles {
  user_id uuid [pk, ref: > users.id]
  therapist_id uuid [ref: > therapist_profiles.user_id]
  current_lsas_score int
  current_program_week int
  current_risk_score int
  is_red_flag_active boolean
}

Table lsas_situations {
  id uuid [pk]
  situation_number int
}

Table lsas_submissions {
  id uuid [pk]
  patient_id uuid [not null, ref: > patient_profiles.user_id]
  submission_type varchar(32)
  total_score int
}

Table lsas_answers {
  id uuid [pk]
  submission_id uuid [not null, ref: > lsas_submissions.id]
  situation_id uuid [not null, ref: > lsas_situations.id]
  fear_score int
  avoidance_score int
}

Table patient_goals {
  id uuid [pk]
  patient_id uuid [not null, ref: > patient_profiles.user_id]
  goal_type varchar(32) [note: "COGNITIVE | EMOTIONAL | BEHAVIORAL | SOCIAL"]
  status varchar(32)
}

Table fear_ladder_items {
  id uuid [pk]
  patient_id uuid [not null, ref: > patient_profiles.user_id]
  situation_id uuid [not null, ref: > lsas_situations.id]
  bucket varchar(32) [note: "EASY | MEDIUM | HARD | EXTREME"]
  status varchar(32)
}

Table behavioral_experiments {
  id uuid [pk]
  patient_id uuid [not null, ref: > patient_profiles.user_id]
  fear_ladder_item_id uuid [not null, ref: > fear_ladder_items.id]
  status varchar(32)
}

Table user_moods {
  id uuid [pk]
  patient_id uuid [not null, ref: > patient_profiles.user_id]
  safety_response varchar(16) [note: "SAFE | UNSAFE"]
}

Table journals {
  id uuid [pk]
  patient_id uuid [not null, ref: > patient_profiles.user_id]
  journal_type varchar(32)
  ai_risk_score int
  severity_level varchar(32)
}

Table appointments {
  id uuid [pk]
  patient_id uuid [not null, ref: > patient_profiles.user_id]
  therapist_id uuid [not null, ref: > therapist_profiles.user_id]
  start_at datetime
  status varchar(32) [note: "BOOKED | COMPLETED | CANCELLED | NO_SHOW"]
  purpose varchar(32)
}

Table therapist_credentials {
  id uuid [pk]
  therapist_id uuid [not null, ref: > therapist_profiles.user_id]
}

Table therapist_schedule_slots {
  id uuid [pk]
  therapist_id uuid [not null, ref: > therapist_profiles.user_id]
}

Table therapist_weekly_schedule_slots {
  id uuid [pk]
  therapist_id uuid [not null, ref: > therapist_profiles.user_id]
}

Table ai_chat_sessions {
  id uuid [pk]
  patient_id uuid [not null, ref: > patient_profiles.user_id]
  session_type varchar(32)
  screen_context varchar(64)
  status varchar(32) [note: "COMPLETED | ESCALATED"]
}

Table ai_chat_messages {
  id uuid [pk]
  session_id uuid [not null, ref: > ai_chat_sessions.id]
  sender_type varchar(16) [note: "PATIENT | ASSISTANT"]
  related_topic_code varchar(64)
  used_fallback boolean
  safety_escalation boolean
  intent_detected varchar(64)
}

Table ai_chat_feedback {
  id uuid [pk]
  message_id uuid [not null, ref: > ai_chat_messages.id]
  patient_id uuid [not null, ref: > patient_profiles.user_id]
  rating int
}
