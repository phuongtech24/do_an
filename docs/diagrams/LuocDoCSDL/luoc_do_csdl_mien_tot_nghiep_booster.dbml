Project ReConnectMindHealth_GraduationBoosterDomain {
  database_type: "MySQL"
  Note: "Lược đồ CSDL miền tốt nghiệp, maintenance và booster"
}

Table patient_profiles {
  user_id uuid [pk]
  therapist_id uuid
  nickname varchar(255)
  graduated_at datetime
  tapering_stage varchar(50)
  current_program_week int
}

Table appointments {
  id uuid [pk]
  patient_id uuid [not null, ref: > patient_profiles.user_id]
  therapist_id uuid
  start_at datetime
  end_at datetime
  purpose varchar(50)
  status varchar(32)
  duration_minutes int
}
