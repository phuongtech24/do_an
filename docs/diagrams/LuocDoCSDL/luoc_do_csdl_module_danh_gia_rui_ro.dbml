Project ReConnectMindHealth_AssessmentRisk {
  database_type: "MySQL"
  Note: "Lược đồ CSDL module LSAS, Daily Check-in, Thought Record và Red Flag"
}

Table patient_profiles {
  user_id uuid [pk]
  nickname varchar(255)
  status varchar(32)
  current_lsas_score int
  current_risk_score int
  is_red_flag_active bool
  safety_gate_completed bool
  triage_required bool
  triage_status varchar(32)
  triage_priority int
  triage_triggered_at datetime
}

Table lsas_situations {
  id uuid [pk]
  situation_number int [not null, unique]
  text varchar(1000) [not null]
  situation_group varchar(100) [not null]
}

Table lsas_submissions {
  id uuid [pk]
  patient_id uuid [not null, ref: > patient_profiles.user_id]
  submission_type varchar(32)
  fear_total int
  avoidance_total int
  total_score int
  unlocked_at datetime
  created_at datetime
}

Table lsas_answers {
  id uuid [pk]
  submission_id uuid [not null, ref: > lsas_submissions.id]
  situation_id uuid [not null, ref: > lsas_situations.id]
  fear_score int
  avoidance_score int
}

Table user_moods {
  id uuid [pk]
  patient_id uuid [ref: > patient_profiles.user_id]
  mood_score int
  anxiety_score int
  sadness_score int
  avoidance_urge_score int
  anticipatory_anxiety_score int
  rumination_score int
  safety_response varchar(20)
  created_at datetime
}

Table daily_risk_logs {
  id uuid [pk]
  patient_id uuid [not null, ref: > patient_profiles.user_id]
  risk_date date
  risk_score int
  score_safety int
  score_ai int
  score_mood int
  red_flag_triggered bool
  recommended_action varchar(100)
  created_at datetime
}

Table journals {
  id uuid [pk]
  patient_id uuid [not null, ref: > patient_profiles.user_id]
  journal_type varchar(32)
  title varchar(255)
  situation text
  automatic_thought text
  emotion_summary text
  ai_risk_score int
  severity_level varchar(50)
  created_at datetime
}
