@startuml
title Biểu đồ hoạt động - Điểm danh cảm xúc, Chốt an toàn và Cờ đỏ

start
:Bệnh nhân mở điểm danh cảm xúc;
:Chấm 5 chỉ số cảm xúc;
:Hệ thống lưu điểm số và suy ra nhãn cảm xúc;

if (Lo âu hoặc Buồn bã vượt ngưỡng nguy cơ?) then (Có)
  :Hiển thị chốt an toàn;
  if (Người dùng chọn "Không an toàn"?) then (Có)
    :Bật Cờ đỏ;
    :Lưu nhật ký nguy cơ;
    :Dừng luồng CBT hiện tại;
    :Mở hỗ trợ khẩn cấp;
    :Đẩy ca bệnh lên dashboard Bác sĩ và Quản trị viên;
    stop
  else (Không)
    :Ghi nhận trạng thái an toàn;
  endif
endif

if (Mức nhẹ?) then (Có)
  :Gợi ý Thẻ đối phó;
elseif (Mức trung bình?)
  :Cho chọn Thẻ đối phó hoặc Nhật ký suy nghĩ;
else (Mức cao)
  :Ưu tiên Nhật ký suy nghĩ;
endif

stop
@enduml