@startuml
title Biểu đồ hoạt động - LSAS và Phân luồng lâm sàng

start
:Bệnh nhân thực hiện LSAS 24 câu;
:Hệ thống tính tổng điểm LSAS;

if (Điểm < 30?) then (Có)
  :Phân luồng An tâm;
  :Hiển thị mẹo chăm sóc tinh thần;
  stop
else (Không)
  if (Điểm từ 30 đến 59?) then (Có)
    :Phân luồng Tự hỗ trợ;
    :Mở luồng tự hỗ trợ;
    stop
  else (Không)
    if (Điểm từ 60 đến 89?) then (Có)
      :Phân luồng Lộ trình 14 tuần;
      :Mở luồng có bác sĩ theo dõi;
      stop
    else (>= 90)
      :Bật Cờ đỏ khẩn cấp;
      :Đưa vào hàng chờ phân loại lâm sàng;
      :Ưu tiên hiển thị trên dashboard Bác sĩ / Quản trị viên;
      stop
    endif
  endif
endif

@enduml
