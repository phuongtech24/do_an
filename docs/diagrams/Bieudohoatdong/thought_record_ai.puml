@startuml
title Biểu đồ hoạt động - Viết Thought Record có hỗ trợ AI

start

:Bệnh nhân mở Thought Record;
:Hệ thống hiển thị quy trình 6 bước;

:Bệnh nhân nhập tình huống,\ncảm xúc, hành vi an toàn,\nsuy nghĩ tự động;

:Hệ thống gọi AI Guided Discovery;

if (AI Guided Discovery phản hồi?) then (Có)
  :Hiển thị 1-2 câu hỏi Socratic;
else (Không)
  :Hiển thị câu hỏi phản biện mặc định;
endif

:Bệnh nhân hoàn thiện\nphản hồi thích nghi;

:Hệ thống gọi AI Cognitive Distortions;

if (AI gợi ý lỗi tư duy?) then (Có)
  :Hiển thị 1-3 lỗi tư duy gợi ý;
else (Không)
  :Cho phép bệnh nhân tiếp tục\nkhông cần gợi ý AI;
endif

:Bệnh nhân bấm lưu Thought Record;
:Hệ thống phân tích aiRiskScore;

if (Nguy cơ cao?) then (Có)
  :Lưu Thought Record + aiRiskScore;
  :Đẩy tín hiệu ưu tiên lâm sàng\nnếu cần;
else (Không)
  :Lưu Thought Record bình thường;
endif

:Hiển thị màn tổng kết bài viết;

stop
@enduml
