@startuml
skinparam defaultFontName "Times New Roman"
title Biểu đồ hoạt động - Đặt lịch và tư vấn từ xa

|Bệnh nhân|
start
:Mở chức năng đặt lịch;
:Xem danh sách khung giờ trống;
:Chọn khung giờ phù hợp;
:Gửi yêu cầu đặt lịch;

|Hệ thống|
:Kiểm tra Bác sĩ phụ trách;
:Kiểm tra khung giờ đã bị đặt chưa;
if (Khung giờ của Bác sĩ đã bị đặt?) then (Có)
  :Từ chối tạo lịch hẹn;
  |Bệnh nhân|
  :Nhận thông báo\nkhung giờ vừa bị người khác đặt;
  stop
else (Không)
  |Hệ thống|
  :Kiểm tra Bệnh nhân có lịch trùng giờ không;
  if (Bệnh nhân đã có lịch trùng?) then (Có)
    :Từ chối tạo lịch hẹn;
    |Bệnh nhân|
    :Nhận thông báo\nđã có lịch hẹn trùng giờ;
    stop
  else (Không)
    |Hệ thống|
    :Tạo lịch hẹn trong transaction;
    :Lưu Appointment;
    |Bệnh nhân|
    :Nhận xác nhận đặt lịch thành công;
    :Xem lịch hẹn đã đặt;
    :Tham gia tư vấn từ xa theo lịch;
    |Bác sĩ|
    :Tham gia phiên tư vấn;
    :Thêm ghi chú lâm sàng sau phiên;
    stop
  endif
endif
@enduml
