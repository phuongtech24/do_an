@startuml
skinparam defaultFontName "Times New Roman"
skinparam wrapWidth 180
skinparam NodePadding 20

|Người dùng|
start
:Vào màn hình bài kiểm tra LSAS;
:Thực hiện chấm điểm 24 tình huống;
:Gửi kết quả bài làm;

|Hệ thống|
:Tính tổng điểm Fear và Avoidance;
:Lưu bài làm và kết quả (LsasSubmission);
if (Tổng điểm < 30?) then (Có)
  :Phân luồng mức 1 (REASSURANCE);
  :Trả về gợi ý trấn an và tự chăm sóc;
else (Không)
  if (Tổng điểm <= 59?) then (Có)
    :Phân luồng mức 2 (SELF_HELP);
    :Mở khóa luồng tự trị liệu CBT;
  else (Không)
    if (Tổng điểm <= 89?) then (Có)
      :Phân luồng mức 3 (THERAPIST_TRACK);
      :Yêu cầu lộ trình CBT 14 tuần có bác sĩ;
    else (Không)
      :Phân luồng mức 4 (URGENT_RED_FLAG);
      :Kích hoạt Cờ đỏ (Red Flag);
      :Đẩy cảnh báo khẩn cấp lên Dashboard Bác sĩ;
    endif
  endif
endif

|Người dùng|
:Nhận kết quả phân tích mức độ;
:Xem hướng dẫn lộ trình tiếp theo;
stop
@enduml