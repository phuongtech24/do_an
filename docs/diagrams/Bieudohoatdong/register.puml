@startuml
title Biểu đồ hoạt động - Đăng ký

start
:Người dùng mở màn hình đăng ký;
:Nhập email;
:Nhập mật khẩu;
:Nhập xác nhận mật khẩu;
:Bấm "Đăng ký";

if (Email đúng định dạng?) then (Có)
  if (Mật khẩu và xác nhận khớp nhau?) then (Có)
    :Hệ thống kiểm tra email đã tồn tại chưa;
    if (Email đã được sử dụng?) then (Có)
      :Hiển thị thông báo email đã tồn tại;
      stop
    else (Không)
      :Tạo tài khoản mới;
      :Khởi tạo hồ sơ người dùng cơ bản;
      :Thông báo đăng ký thành công;
      :Chuyển sang màn hình đăng nhập;
      stop
    endif
  else (Không)
    :Thông báo mật khẩu xác nhận không khớp;
    stop
  endif
else (Không)
  :Thông báo email không hợp lệ;
  stop
endif

@enduml