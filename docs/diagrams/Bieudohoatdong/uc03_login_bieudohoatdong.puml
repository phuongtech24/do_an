@startuml
skinparam defaultFontName "Times New Roman"
skinparam wrapWidth 180
skinparam NodePadding 20

|Người dùng|
start
:Truy cập màn hình đăng nhập;
:Nhập email và mật khẩu;

|Hệ thống|
:Kiểm tra định dạng email và mật khẩu;
if (Định dạng hợp lệ?) then (Không)
  :Thông báo lỗi định dạng;
  |Người dùng|
  :Nhập lại thông tin;
  detach
else (Có)
  |Hệ thống|
  :Kiểm tra tài khoản tồn tại và trạng thái hoạt động;
  if (Tài khoản hợp lệ?) then (Không)
    :Thông báo tài khoản không tồn tại hoặc bị khóa;
    |Người dùng|
    :Nhập lại thông tin;
    detach
  else (Có)
    |Hệ thống|
    :Kiểm tra trạng thái xác minh email;
    if (Đã xác minh OTP?) then (Chưa)
      :Yêu cầu xác minh email;
      |Người dùng|
      :Yêu cầu gửi mã (nếu cần);
      |Hệ thống|
      :Gửi mã OTP qua Gmail;
      |Người dùng|
      :Nhận và nhập mã OTP;
      |Hệ thống|
      :Kiểm tra mã OTP;
      if (Mã OTP chính xác?) then (Không)
        :Thông báo sai mã hoặc mã hết hạn;
        |Người dùng|
        :Nhập lại mã OTP;
        detach
      else (Có)
        |Hệ thống|
        :Cập nhật trạng thái tài khoản (Verified);
      endif
    else (Rồi)
    endif
    
    |Hệ thống|
    :Kiểm tra mật khẩu;
    if (Mật khẩu đúng?) then (Không)
      :Thông báo sai mật khẩu;
      |Người dùng|
      :Nhập lại thông tin;
      detach
    else (Có)
      |Hệ thống|
      :Tạo phiên đăng nhập;
      :Điều hướng vào màn hình phù hợp;
      stop
    endif
  endif
endif
@enduml
