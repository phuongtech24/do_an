@startuml
title Biểu đồ hoạt động - Đăng nhập

start
:Người dùng mở màn hình đăng nhập;
:Nhập email và mật khẩu;
if (Chọn ghi nhớ đăng nhập?) then (Có)
  :Đánh dấu ghi nhớ phiên;
else (Không)
endif
:Bấm "Đăng nhập";

if (Đã nhập đầy đủ thông tin?) then (Có)
  :Hệ thống kiểm tra tài khoản theo email;
  if (Tài khoản tồn tại?) then (Có)
    if (Tài khoản đang hoạt động?) then (Có)
      :Hệ thống xác thực mật khẩu;
      if (Mật khẩu đúng?) then (Đúng)
        :Tạo access token và refresh token;
        :Tạo phiên đăng nhập;
        :Nạp hồ sơ và vai trò người dùng;
        :Điều hướng vào màn hình phù hợp;
        stop
      else (Sai)
        :Hiển thị thông báo sai mật khẩu;
        stop
      endif
    else (Không)
      :Thông báo tài khoản bị vô hiệu hóa;
      stop
    endif
  else (Không)
    :Hiển thị thông báo tài khoản không tồn tại;
    stop
  endif
else (Không)
  :Yêu cầu nhập đầy đủ thông tin;
  stop
endif

@enduml