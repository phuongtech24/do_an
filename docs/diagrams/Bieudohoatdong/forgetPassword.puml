@startuml
title Biểu đồ hoạt động - Quên mật khẩu

start
:Người dùng chọn "Quên mật khẩu";
:Nhập email đã đăng ký;
:Bấm gửi yêu cầu;

if (Email hợp lệ và tồn tại?) then (Có)
  :Hệ thống tạo token đặt lại mật khẩu;
  :Gửi email chứa token hoặc liên kết đặt lại mật khẩu;
  :Người dùng mở email reset;
  :Nhập token, mật khẩu mới và xác nhận mật khẩu;
  if (Token còn hiệu lực và hợp lệ?) then (Có)
    if (Mật khẩu mới hợp lệ?) then (Có)
      :Cập nhật mật khẩu mới;
      :Vô hiệu hóa token reset;
      :Thông báo đặt lại mật khẩu thành công;
      stop
    else (Không)
      :Yêu cầu nhập lại mật khẩu hợp lệ;
      stop
    endif
  else (Không)
    :Thông báo token không hợp lệ hoặc đã hết hạn;
    stop
  endif
else (Không)
  :Hiển thị thông báo email không tồn tại hoặc không hợp lệ;
  stop
endif

@enduml