@startuml

!include <logos/flutter>
!include <logos/spring>
!include <logos/mysql>
!include <logos/redis>
!include <logos/nginx>
!include <logos/docker>
!include <logos/github>
!include <logos/google>

skinparam dpi 150
skinparam defaultFontName "Segoe UI"
skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam nodesep 40
skinparam ranksep 50
skinparam roundcorner 12
skinparam shadowing false
skinparam ComponentPadding 10
top to bottom direction

skinparam Node {
    BackgroundColor #F8F9FA
    BorderColor #CED4DA
    BorderThickness 2
    FontColor #343A40
    FontSize 13
    FontStyle bold
}

skinparam Component {
    BackgroundColor #FFFFFF
    BorderColor #ADB5BD
    BorderThickness 1.5
    FontColor #333333
    FontSize 12
}

skinparam Database {
    BackgroundColor #FFFFFF
    BorderColor #ADB5BD
    BorderThickness 1.5
    FontColor #333333
    FontSize 12
}

skinparam Cloud {
    BackgroundColor #E9ECEF
    BorderColor #CED4DA
    BorderThickness 2
    FontColor #343A40
    FontSize 13
    FontStyle bold
}

skinparam Arrow {
    FontSize 11
    FontColor #555555
}

title Biểu đồ kiến trúc công nghệ hệ thống ReConnect MindHealth

actor "Bệnh nhân" as Patient
actor "Bác sĩ / Quản trị viên" as Staff

cloud "<color:#181717><$github,scale=1.0></color>\nGitHub" as GitHub
cloud "<color:#181717><$github,scale=1.0></color>\nGitHub Actions\nCI / CD" as GHA
cloud "<color:#2496ED><$docker,scale=1.0></color>\nGHCR\nDocker Registry" as GHCR
cloud "<color:#4285F4><$google,scale=1.0></color>\nGemini API" as Gemini

frame "Lớp Client" {
  component "<color:#02569B><$flutter,scale=1.0></color>\nFlutter Mobile App\n(reconnect_app)" as MobileApp
  component "<color:#02569B><$flutter,scale=1.0></color>\nFlutter Web CMS\n(reconnect_web)" as WebApp
}

node "Docker Compose / Container Runtime" as Runtime {
  component "<color:#009639><$nginx,scale=1.0></color>\nNginx\n(Reverse Proxy)" as Nginx
  component "<color:#6DB33F><$spring,scale=1.0></color>\nSpring Boot REST API\nJava 17 + Spring Boot 3.2.4" as Backend
  database "<color:#4479A1><$mysql,scale=1.0></color>\nMySQL 8\nCSDL Nghiệp vụ" as MySQL
  database "<color:#DC382D><$redis,scale=1.0></color>\nRedis 7\nCache / Rate limit" as Redis
  folder "Docker Volumes" as Storage
}

Patient ---> MobileApp : "Sử dụng app"
Staff ---> WebApp : "Quản trị lâm sàng"

MobileApp ---> Backend : "HTTP/JSON API"
WebApp ---> Nginx : "HTTPS / HTTP"
Nginx ---> Backend : "Proxy pass /api"

Backend ---> MySQL : "CRUD dữ liệu"
Backend ---> Redis : "Cache dữ liệu"
Backend ---> Storage : "Lưu tệp Uploads"
Backend ---> Gemini : "Phân tích AI"

GitHub ---> GHA : "Push code"
GHA ---> Backend : "Maven build"
GHA ---> WebApp : "Flutter build"
GHA ---> Runtime : "Docker validation"
GHA ---> GHCR : "Publish images"
GHCR ...> Backend : "Pull backend"
GHCR ...> Nginx : "Pull web"

@enduml
