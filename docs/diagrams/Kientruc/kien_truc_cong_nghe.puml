@startuml

!include <logos/flutter>
!include <logos/spring>
!include <logos/mysql>
!include <logos/redis>
!include <logos/nginx>
!include <logos/docker>
!include <logos/github>
!include <logos/google>

skinparam dpi 200
skinparam defaultFontName "Segoe UI"
skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam nodesep 80
skinparam ranksep 100
skinparam roundcorner 15
skinparam shadowing true
skinparam padding 15
skinparam ComponentPadding 25
left to right direction

skinparam Node {
    BackgroundColor #F8F9FA
    BorderColor #CED4DA
    BorderThickness 2
    FontColor #343A40
    FontSize 16
    FontStyle bold
}

skinparam Component {
    BackgroundColor #FFFFFF
    BorderColor #ADB5BD
    BorderThickness 1.5
    FontColor #333333
    FontSize 14
}

skinparam Database {
    BackgroundColor #FFFFFF
    BorderColor #ADB5BD
    BorderThickness 1.5
    FontColor #333333
    FontSize 14
}

skinparam Cloud {
    BackgroundColor #E9ECEF
    BorderColor #CED4DA
    BorderThickness 2
    FontColor #343A40
    FontSize 16
    FontStyle bold
}

skinparam Arrow {
    FontSize 14
    FontColor #555555
}

title Biểu đồ kiến trúc công nghệ hệ thống ReConnect MindHealth

actor "Bệnh nhân" as Patient
actor "Bác sĩ / Quản trị viên" as Staff

cloud "<color:#181717><$github,scale=1.2></color>\nGitHub" as GitHub
cloud "<color:#181717><$github,scale=1.2></color>\nGitHub Actions\nCI / CD" as GHA
cloud "<color:#2496ED><$docker,scale=1.2></color>\nGHCR\nDocker Registry" as GHCR
cloud "<color:#4285F4><$google,scale=1.2></color>\nGemini API" as Gemini
cloud "<color:#EA4335><$google,scale=1.2></color>\nGmail SMTP" as Gmail

frame "Lớp Client" {
  component "<color:#02569B><$flutter,scale=1.2></color>\nFlutter Mobile App\n(reconnect_app)" as MobileApp
  component "<color:#02569B><$flutter,scale=1.2></color>\nFlutter Web CMS\n(reconnect_web)" as WebApp
}

node "Docker Compose / Container Runtime" as Runtime {
  component "<color:#009639><$nginx,scale=1.2></color>\nNginx\n(Phục vụ Web / Reverse Proxy)" as Nginx
  component "<color:#6DB33F><$spring,scale=1.2></color>\nSpring Boot REST API\nJava 17 + Spring Boot 3.2.4" as Backend
  database "<color:#4479A1><$mysql,scale=1.2></color>\nMySQL 8\nCSDL Nghiệp vụ" as MySQL
  database "<color:#DC382D><$redis,scale=1.2></color>\nRedis 7\nCache / Rate limit" as Redis
  component "<color:#D44638><$google,scale=1.2></color>\nMailpit\nLocal SMTP" as Mailpit
  folder "Docker Volumes" as Storage
}

Patient ---> MobileApp : "Sử dụng app"
Staff ---> WebApp : "Quản trị lâm sàng"

MobileApp ---> Backend : "HTTP/JSON API"
WebApp ---> Nginx : "HTTPS / HTTP"
Nginx ---> Backend : "Proxy pass /api"

Backend ---> MySQL : "CRUD dữ liệu"
Backend ---> Redis : "Cache dữ liệu"
Backend ---> Storage : "Lưu tệp Uploads"
Backend ---> Mailpit : "Gửi mail local"
Backend ---> Gemini : "Phân tích AI"
Backend ...> Gmail : "Gửi mail thật"

GitHub ---> GHA : "Push code"
GHA ---> Backend : "Maven build"
GHA ---> WebApp : "Flutter build"
GHA ---> Runtime : "Docker validation"
GHA ---> GHCR : "Publish images"
GHCR ...> Backend : "Pull backend"
GHCR ...> Nginx : "Pull web"

@enduml
