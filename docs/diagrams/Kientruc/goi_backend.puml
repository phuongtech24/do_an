@startuml
skinparam defaultFontName "Times New Roman"
left to right direction
title Biểu đồ gói backend ReConnect MindHealth

package "common" as Common {
  package "security" as CommonSecurity
  package "domain" as CommonDomain
  package "config" as CommonConfig
}

package "modules.auth" as Auth {
  package "controller" as AuthController
  package "service" as AuthService
  package "repository" as AuthRepository
  package "entity" as AuthEntity
  package "dto" as AuthDto
}

package "modules.guest" as Guest {
  package "controller" as GuestController
  package "service" as GuestService
  package "repository" as GuestRepository
  package "entity" as GuestEntity
}

package "modules.assessment" as Assessment {
  package "controller" as AssessmentController
  package "service" as AssessmentService
  package "repository" as AssessmentRepository
  package "entity" as AssessmentEntity
}

package "modules.clinical" as Clinical {
  package "controller" as ClinicalController
  package "service" as ClinicalService
  package "repository" as ClinicalRepository
  package "entity" as ClinicalEntity
}

package "modules.roadmap" as Roadmap {
  package "controller" as RoadmapController
  package "service" as RoadmapService
  package "repository" as RoadmapRepository
  package "entity" as RoadmapEntity
}

package "modules.journal" as Journal {
  package "controller" as JournalController
  package "service" as JournalService
  package "repository" as JournalRepository
  package "entity" as JournalEntity
}

package "modules.ai" as Ai {
  package "controller" as AiController
  package "service" as AiService
  package "prompt" as AiPrompt
  package "knowledge" as AiKnowledge
}

package "modules.booster" as Booster {
  package "controller" as BoosterController
  package "service" as BoosterService
  package "repository" as BoosterRepository
  package "entity" as BoosterEntity
}

package "modules.admin" as Admin {
  package "controller" as AdminController
  package "service" as AdminService
}

AuthController --> AuthService
AuthService --> AuthRepository
AuthRepository --> AuthEntity
AuthService --> AuthDto

GuestController --> GuestService
GuestService --> GuestRepository
GuestRepository --> GuestEntity

AssessmentController --> AssessmentService
AssessmentService --> AssessmentRepository
AssessmentRepository --> AssessmentEntity

ClinicalController --> ClinicalService
ClinicalService --> ClinicalRepository
ClinicalRepository --> ClinicalEntity

RoadmapController --> RoadmapService
RoadmapService --> RoadmapRepository
RoadmapRepository --> RoadmapEntity

JournalController --> JournalService
JournalService --> JournalRepository
JournalRepository --> JournalEntity

AiController --> AiService
AiService --> AiPrompt
AiService --> AiKnowledge

BoosterController --> BoosterService
BoosterService --> BoosterRepository
BoosterRepository --> BoosterEntity

AdminController --> AdminService
AdminService --> ClinicalService

AuthController ..> CommonSecurity
AssessmentService ..> ClinicalEntity
RoadmapService ..> AssessmentEntity
RoadmapService ..> ClinicalEntity
JournalService ..> AiService
BoosterService ..> ClinicalEntity

@enduml
