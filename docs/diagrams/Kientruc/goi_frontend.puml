@startuml
skinparam defaultFontName "Times New Roman"
left to right direction
title Biểu đồ gói frontend ReConnect MindHealth

package "Flutter Mobile - Ứng dụng Bệnh nhân" as Mobile {
  package "app" as MobileApp
  package "core" as MobileCore
  package "network" as MobileNetwork
  package "features.auth" as MobileAuth
  package "features.assessment" as MobileAssessment
  package "features.journal" as MobileJournal
  package "features.roadmap" as MobileRoadmap
  package "features.ai_journal" as MobileAi
  package "screens" as MobileScreens
  package "shared.widgets" as MobileShared
}

package "Flutter Web - Bác sĩ / Quản trị viên" as Web {
  package "core" as WebCore
  package "data" as WebData
  package "domain" as WebDomain
  package "features.therapist" as WebTherapistFeature
  package "screens.admin" as WebAdminScreens
  package "screens.therapist" as WebTherapistScreens
  package "shared" as WebShared
}

MobileScreens --> MobileAuth
MobileScreens --> MobileAssessment
MobileScreens --> MobileJournal
MobileScreens --> MobileRoadmap
MobileScreens --> MobileAi

MobileAuth --> MobileNetwork
MobileAssessment --> MobileNetwork
MobileJournal --> MobileNetwork
MobileRoadmap --> MobileNetwork
MobileAi --> MobileNetwork

MobileAuth --> MobileCore
MobileAssessment --> MobileCore
MobileJournal --> MobileCore
MobileRoadmap --> MobileCore
MobileAi --> MobileCore
MobileScreens --> MobileShared

WebAdminScreens --> WebData
WebTherapistScreens --> WebData
WebData --> WebDomain
WebData --> WebCore
WebAdminScreens --> WebShared
WebTherapistScreens --> WebShared
WebTherapistFeature --> WebData

@enduml
