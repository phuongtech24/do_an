@startuml
skinparam defaultFontName "Segoe UI"
skinparam linetype ortho
skinparam nodesep 50
skinparam ranksep 70
skinparam roundcorner 10
skinparam shadowing true
skinparam packageStyle rectangle

skinparam Package {
    BackgroundColor #F8F9FA
    BorderColor #343A40
    BorderThickness 2
    FontSize 16
    FontStyle bold
}

skinparam Folder {
    BackgroundColor #FFFFFF
    BorderColor #28A745
    BorderThickness 1.5
    FontSize 14
}

skinparam Frame {
    BackgroundColor transparent
    BorderColor #AAAAAA
    BorderThickness 1
    FontColor #666666
    FontSize 13
    FontStyle italic
}

skinparam Arrow {
    Color #555555
    Thickness 1.5
}

title Biểu đồ gói (Package Diagram) - Backend ReConnect MindHealth

package "Spring Boot Backend (com.reconnect.mindhealth)" as Backend {

    frame "Tầng Dùng chung & Cấu hình (Common Layer)" {
        package "common" as Common {
            folder "config"
            folder "security"
            folder "domain"
        }
    }

    frame "Tầng Nghiệp vụ Độc lập (Standalone Modules)" {
        package "modules.auth" as Auth {
            folder "controller" as AuthCtrl
            folder "service" as AuthSvc
            folder "dto" as AuthDto
            folder "repository" as AuthRepo
            folder "entity" as AuthEnt
            
            AuthCtrl -down-> AuthSvc
            AuthSvc -down-> AuthRepo
            AuthSvc -down-> AuthDto
            AuthRepo -down-> AuthEnt
        }

        package "modules.ai" as Ai {
            folder "prompt"
            folder "knowledge"
        }
        
        package "modules.guest" as Guest
    }

    frame "Tầng Nghiệp vụ Bệnh nhân (Patient Features)" {
        package "modules.journal" as Journal
        package "modules.roadmap" as Roadmap
        package "modules.assessment" as Assessment
    }

    frame "Tầng Nghiệp vụ Lâm sàng & Telehealth (Clinical Features)" {
        package "modules.booster" as Booster
        package "modules.admin" as Admin
        package "modules.clinical" as Clinical
    }

    ' Luồng phụ thuộc giữa các module
    Journal -down-> Ai : "Phân tích AI"
    
    Roadmap -down-> Assessment : "Lấy bài test"
    
    Booster -down-> Clinical : "Cập nhật hồ sơ"
    Admin -down-> Clinical : "Xem hồ sơ"
    Assessment -down-> Clinical : "Lưu kết quả"
}

@enduml
