Project ReConnectMindHealth {
  database_type: "MySQL"
  Note: "ERD tổng quát 11 bảng cốt lõi của ReConnect MindHealth"
}

Enum user_role {
  GUEST
  PATIENT
  THERAPIST
  ADMIN
}

Enum therapist_approval_status {
  PENDING
  APPROVED
  REJECTED
}

Enum patient_status {
  STABLE
  AT_RISK
  CRISIS
}

Enum lsas_submission_type {
  DEMO
  BASELINE
  RERATE
}

Enum tapering_stage {
  NONE
  BIWEEKLY
  EVERY_3_WEEKS
  EVERY_4_WEEKS
  MAINTENANCE
}

Enum fear_ladder_bucket {
  EASY
  MEDIUM
  HARD
}

Enum fear_ladder_status {
  LOCKED
  ACTIVE
  MASTERED
}

Enum experiment_source_type {
  SYSTEM
  THERAPIST
}

Enum experiment_status {
  PLANNED
  IN_PROGRESS
  DONE
}

Enum appointment_status {
  BOOKED
  COMPLETED
  CANCELLED
  MISSED
}

Enum appointment_purpose {
  CBT_SESSION
  INITIAL_ASSESSMENT
  BEHAVIORAL_EXPERIMENT
  BOOSTER
  CRISIS
}

Enum journal_type {
  THOUGHT_RECORD
  FREE_JOURNAL
}

Table users {
  id uuid [pk]
  email varchar(255) [not null, unique]
  username varchar(255)
  password_hash varchar(255) [not null]
  role user_role [not null]
  is_anonymous bool [not null, default: false]
  is_active bool [not null, default: true]
  reset_password_token varchar(128)
  reset_password_expires_at datetime
  created_at datetime
}

Table guest_profiles {
  user_id uuid [pk, ref: > users.id]
  nickname varchar(255)
  avatar_icon varchar(100)
  lsas_demo_completed bool [not null, default: false]
  pending_lsas_answers_json longtext
  pending_lsas_total_score int
  pending_lsas_submission_type varchar(50)
  pending_lsas_completed_at datetime
}

Table therapist_profiles {
  user_id uuid [pk, ref: > users.id]
  full_name varchar(255) [not null]
  specialization varchar(255)
  bio text
  hometown varchar(255)
  birth_year int
  therapy_style text
  meeting_link varchar(500)
  avatar_url varchar(500)
  approval_status therapist_approval_status
}

Table patient_profiles {
  user_id uuid [pk, ref: > users.id]
  therapist_id uuid [ref: > therapist_profiles.user_id]
  nickname varchar(255) [unique]
  status patient_status
  avatar_icon varchar(100)
  anonymous_mode_enabled bool [not null, default: true]
  real_full_name varchar(255)
  date_of_birth date
  gender varchar(20)
  phone_number varchar(20)
  emergency_contact_phone varchar(20)
  education_level varchar(100)
  occupation varchar(255)
  relationship_status varchar(100)
  medical_history text
  lsas_demo_completed bool [not null, default: false]
  medical_profile_completed bool [not null, default: false]
  current_risk_score int [not null, default: 0]
  is_red_flag_active bool [not null, default: false]
  current_lsas_score int [not null, default: 0]
  current_program_week int
  therapy_program_started_at datetime
  tapering_stage tapering_stage
  graduated_at datetime
  triage_required bool [not null, default: false]
  triage_status varchar(50)
  triage_priority int
  triage_triggered_at datetime
}

Table lsas_submissions {
  id uuid [pk]
  patient_id uuid [not null, ref: > patient_profiles.user_id]
  submission_type lsas_submission_type [not null]
  fear_total int [not null, default: 0]
  avoidance_total int [not null, default: 0]
  total_score int [not null, default: 0]
  unlocked_at datetime
  created_at datetime
}

Table user_moods {
  id uuid [pk]
  patient_id uuid [ref: > patient_profiles.user_id]
  mood_score int
  anxiety_score int
  avoidance_urge_score int
  sadness_score int
  anticipatory_anxiety_score int
  post_event_rumination_score int
  daily_agenda varchar(255)
  safety_check_required bool
  safety_response varchar(20)
  safety_responded_at datetime
  created_at datetime
}

Table daily_risk_logs {
  id uuid [pk]
  patient_id uuid [not null, ref: > patient_profiles.user_id]
  risk_date date [not null]
  risk_score int [not null]
  score_safety int [not null]
  score_ai int [not null]
  score_mood int [not null]
  override_triggered bool [not null, default: false]
  red_flag_active bool [not null, default: false]
  calculated_at datetime [not null]
}

Table journals {
  id uuid [pk]
  patient_id uuid [not null, ref: > patient_profiles.user_id]
  journal_type journal_type [not null]
  content_encrypted text
  ai_risk_score int [default: 0]
  severity_level varchar(50)
  ai_risk_distortions_json text
  ai_risk_reason text
  created_at datetime
}

Table fear_ladder_items {
  id uuid [pk]
  patient_id uuid [not null, ref: > patient_profiles.user_id]
  situation_id uuid
  baseline_fear_score int [not null, default: 0]
  baseline_avoidance_score int [not null, default: 0]
  baseline_total_score int [not null, default: 0]
  current_fear_score int [not null, default: 0]
  current_avoidance_score int [not null, default: 0]
  current_total_score int [not null, default: 0]
  bucket fear_ladder_bucket [not null]
  ladder_order int [not null]
  status fear_ladder_status [not null]
  create_date datetime
}

Table behavioral_experiments {
  id uuid [pk]
  patient_id uuid [not null, ref: > patient_profiles.user_id]
  fear_ladder_item_id uuid [not null, ref: > fear_ladder_items.id]
  source_type experiment_source_type [not null]
  status experiment_status [not null]
  prediction text
  prediction_belief_before int
  prediction_belief_after int
  safety_behaviors_json json
  outcome text
  learning text
  execution_notes text
  proof_image_url varchar(500)
  post_fear_score int
  post_avoidance_score int
  assigned_at datetime [not null]
  setup_completed_at datetime
  started_at datetime
  completed_at datetime
}

Table appointments {
  id uuid [pk]
  patient_id uuid [not null, ref: > patient_profiles.user_id]
  therapist_id uuid [not null, ref: > therapist_profiles.user_id]
  start_at datetime [not null]
  end_at datetime [not null]
  status appointment_status [not null]
  purpose appointment_purpose [not null]
  clinical_purpose_code varchar(100)
  care_phase_code varchar(100)
  is_anonymous bool [not null, default: true]
  meeting_link varchar(500)
  therapist_notes text
  created_at datetime
}
