Project ReConnectMindHealth {
  database_type: "MySQL"
  Note: "ERD tổng quát 19 bảng đầy đủ của ReConnect MindHealth"
}

Enum user_role {
  GUEST
  PATIENT
  THERAPIST
  ADMIN
}

Enum therapist_approval_status {
  PENDING
  APPROVED
  REJECTED
}

Enum patient_status {
  STABLE
  AT_RISK
  CRISIS
}

Enum lsas_submission_type {
  DEMO
  BASELINE
  RERATE
}

Enum tapering_stage {
  NONE
  BIWEEKLY
  EVERY_3_WEEKS
  EVERY_4_WEEKS
  MAINTENANCE
}

Enum fear_ladder_bucket {
  EASY
  MEDIUM
  HARD
}

Enum fear_ladder_status {
  LOCKED
  ACTIVE
  MASTERED
}

Enum experiment_source_type {
  SYSTEM
  THERAPIST
}

Enum experiment_status {
  PLANNED
  IN_PROGRESS
  DONE
}

Enum appointment_status {
  BOOKED
  COMPLETED
  CANCELLED
  MISSED
}

Enum appointment_purpose {
  CBT_SESSION
  INITIAL_ASSESSMENT
  BEHAVIORAL_EXPERIMENT
  BOOSTER
  CRISIS
}

Enum journal_type {
  THOUGHT_RECORD
  FREE_JOURNAL
}

Table users {
  id uuid [pk]
  role user_role [not null]
}

Table guest_profiles {
  user_id uuid [pk, ref: > users.id]
}

Table therapist_profiles {
  user_id uuid [pk, ref: > users.id]
}

Table patient_profiles {
  user_id uuid [pk, ref: > users.id]
  therapist_id uuid [ref: > therapist_profiles.user_id]
}

Table lsas_submissions {
  id uuid [pk]
  patient_id uuid [not null, ref: > patient_profiles.user_id]
  submission_type lsas_submission_type [not null]
}

Table user_moods {
  id uuid [pk]
  patient_id uuid [ref: > patient_profiles.user_id]
}

Table daily_risk_logs {
  id uuid [pk]
  patient_id uuid [not null, ref: > patient_profiles.user_id]
}

Table journals {
  id uuid [pk]
  patient_id uuid [not null, ref: > patient_profiles.user_id]
  journal_type journal_type [not null]
}

Table fear_ladder_items {
  id uuid [pk]
  patient_id uuid [not null, ref: > patient_profiles.user_id]
  bucket fear_ladder_bucket [not null]
  status fear_ladder_status [not null]
}

Table behavioral_experiments {
  id uuid [pk]
  patient_id uuid [not null, ref: > patient_profiles.user_id]
  fear_ladder_item_id uuid [not null, ref: > fear_ladder_items.id]
  source_type experiment_source_type [not null]
  status experiment_status [not null]
}

Table appointments {
  id uuid [pk]
  patient_id uuid [not null, ref: > patient_profiles.user_id]
  therapist_id uuid [not null, ref: > therapist_profiles.user_id]
  status appointment_status [not null]
  purpose appointment_purpose [not null]
}

Table therapist_credentials {
  id uuid [pk]
  therapist_id uuid [not null, ref: > therapist_profiles.user_id]
}

Table lsas_situations {
  id uuid [pk]
}

Table lsas_answers {
  id uuid [pk]
  submission_id uuid [not null, ref: > lsas_submissions.id]
  situation_id uuid [not null, ref: > lsas_situations.id]
}

Table quest_templates {
  id uuid [pk]
}

Table patient_quests {
  id uuid [pk]
  patient_id uuid [not null, ref: > patient_profiles.user_id]
  quest_template_id uuid [ref: > quest_templates.id]
}

Table patient_goals {
  id uuid [pk]
  patient_id uuid [not null, ref: > patient_profiles.user_id]
}

Table therapist_schedule_slots {
  id uuid [pk]
  therapist_id uuid [not null, ref: > therapist_profiles.user_id]
}

Table therapist_weekly_schedule_slots {
  id uuid [pk]
  therapist_id uuid [not null, ref: > therapist_profiles.user_id]
}
