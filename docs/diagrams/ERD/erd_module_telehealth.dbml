Project ReConnectMindHealth_Telehealth {
  database_type: "MySQL"
  Note: "ERD theo module Therapist Matching - Telehealth - Graduation - Booster"
}

Enum therapist_approval_status {
  PENDING
  APPROVED
  REJECTED
}

Enum tapering_stage {
  NONE
  BIWEEKLY
  EVERY_3_WEEKS
  EVERY_4_WEEKS
  MAINTENANCE
}

Enum appointment_status {
  BOOKED
  COMPLETED
  CANCELLED
  MISSED
}

Enum appointment_purpose {
  CBT_SESSION
  INITIAL_ASSESSMENT
  BEHAVIORAL_EXPERIMENT
  BOOSTER
  CRISIS
}

Table therapist_profiles {
  user_id uuid [pk]
  full_name varchar(255) [not null]
  specialization varchar(255)
  therapy_style text
  meeting_link varchar(500)
  approval_status therapist_approval_status
}

Table patient_profiles {
  user_id uuid [pk]
  therapist_id uuid [ref: > therapist_profiles.user_id]
  nickname varchar(255)
  anonymous_mode_enabled bool [not null, default: true]
  tapering_stage tapering_stage
  triage_required bool [not null, default: false]
  triage_status varchar(50)
  triage_priority int
  triage_triggered_at datetime
  graduated_at datetime
}

Table appointments {
  id uuid [pk]
  patient_id uuid [not null, ref: > patient_profiles.user_id]
  therapist_id uuid [not null, ref: > therapist_profiles.user_id]
  start_at datetime [not null]
  end_at datetime [not null]
  status appointment_status [not null]
  purpose appointment_purpose [not null]
  clinical_purpose_code varchar(100)
  care_phase_code varchar(100)
  is_anonymous bool [not null, default: true]
  meeting_link varchar(500)
  therapist_notes text
  created_at datetime
}
