@startuml
skinparam defaultFontName "Times New Roman"
skinparam shadowing false
skinparam monochrome true
skinparam nodesep 80
skinparam ranksep 70
skinparam usecaseFontSize 14
left to right direction
title UC02 - Đánh giá LSAS và phân luồng lâm sàng

actor "Khách / Bệnh nhân" as A

usecase "Form_LsasAssessment" as B1
usecase "Form_LsasResult" as B2

usecase "ctrl_LsasSubmit" as C1
usecase "ctrl_ClinicalRouting" as C2

usecase "Ent_LsasSituation" as E1
usecase "Ent_LsasAnswer" as E2
usecase "Ent_LsasSubmission" as E3
usecase "Ent_PatientProfile" as E4

A -- B1
A -- B2

B1 -- C1
B2 -- C2

C1 -- E1
C1 -- E2
C1 -- E3

C2 -- E3
C2 -- E4

B1 -[hidden]-> B2
B2 -[hidden]-> C1
C1 -[hidden]-> C2
C2 -[hidden]-> E1
E1 -[hidden]down-> E2
E2 -[hidden]down-> E3
E3 -[hidden]down-> E4
@enduml
