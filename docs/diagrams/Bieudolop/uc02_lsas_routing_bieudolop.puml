@startuml
skinparam defaultFontName "Times New Roman"
skinparam shadowing false
skinparam monochrome true
skinparam linetype ortho
skinparam nodesep 45
skinparam ranksep 40
title UC02 - Đánh giá LSAS và phân luồng lâm sàng
left to right direction
actor "Khách / Bệnh nhân" as A
boundary "Form_LsasAssessment" as B1
boundary "Form_LsasResult" as B2
control "ctrl_LsasSubmit" as C1
control "ctrl_ClinicalRouting" as C2
entity "Ent_LsasSituation" as E1
entity "Ent_LsasAnswer" as E2
entity "Ent_LsasSubmission" as E3
entity "Ent_PatientProfile" as E4
B1 -[hidden]down-> B2
C1 -[hidden]down-> C2
E1 -[hidden]down-> E2
E2 -[hidden]down-> E3
E3 -[hidden]down-> E4
A -- B1
A -- B2
B1 -- C1
B2 -- C2
C1 -- E1
C1 -- E2
C1 -- E3
C2 -- E3
C2 -- E4
@enduml
