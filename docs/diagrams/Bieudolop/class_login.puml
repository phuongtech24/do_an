@startuml
title Biểu đồ lớp - Chức năng đăng nhập

class User {
  +id: UUID
  +email: String
  +passwordHash: String
  +role: Role
  +isActive: Boolean
}

class RefreshToken {
  +id: UUID
  +token: String
  +expiresAt: DateTime
  +revoked: Boolean
}

class LoginRequest {
  +email: String
  +password: String
  +rememberMe: Boolean
}

class LoginResponse {
  +accessToken: String
  +refreshToken: String
  +expiresIn: Long
  +refreshExpiresIn: Long
}

class AuthController {
  +login(request)
  +refreshToken(request)
}

class AuthService {
  +login(request)
  +refreshToken(token)
}

class JwtUtil {
  +generateAccessToken(user)
  +generateRefreshToken(user)
  +validateAccessToken(token)
  +validateRefreshToken(token)
}

enum Role {
  GUEST
  PATIENT
  THERAPIST
  ADMIN
}

User "1" -- "0..*" RefreshToken
AuthController ..> AuthService
AuthController ..> LoginRequest
AuthService ..> User
AuthService ..> RefreshToken
AuthService ..> LoginResponse
AuthService ..> JwtUtil

@enduml
