E2 -[hidden]down-> E3
E3 -[hidden]down-> E4
E4 -[hidden]down-> E5
E5 -[hidden]down-> E6
E6 -[hidden]down-> E7
E7 -[hidden]down-> E8

A -- B1
A -- B2
A -- B3
B1 -- C1
B2 -- C2
B3 -- C3
C1 -- E1
C2 -- E1
C2 -- E2
C2 -- E3
C2 -- E4
C2 -- E5
C2 -- E6
C2 -- E7
C2 -- E8
