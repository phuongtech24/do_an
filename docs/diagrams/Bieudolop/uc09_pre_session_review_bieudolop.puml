@startuml
skinparam defaultFontName "Times New Roman"
skinparam shadowing false
skinparam monochrome true
skinparam nodesep 60
skinparam ranksep 45
skinparam usecaseFontSize 14
title UC09 - Xem trước phiên tư vấn
left to right direction

actor "Bác sĩ" as A
usecase "Form_TherapistDashboard" as B1
usecase "Form_PreSessionReview" as B2
usecase "Form_PatientDetail" as B3
usecase "ctrl_DashboardLoad" as C1
usecase "ctrl_PreSessionReview" as C2
usecase "ctrl_ClinicalNote" as C3
usecase "Ent_PatientProfile" as E1
usecase "Ent_PatientGoal" as E2
usecase "Ent_LsasSubmission" as E3
usecase "Ent_Journal" as E4
usecase "Ent_UserMood" as E5
usecase "Ent_FearLadderItem" as E6
usecase "Ent_BehavioralExperiment" as E7
usecase "Ent_Appointment" as E8

B1 -[hidden]-> B2
B2 -[hidden]-> B3
B3 -[hidden]-> C1
C1 -[hidden]-> C2
C2 -[hidden]-> C3
C3 -[hidden]-> E1
