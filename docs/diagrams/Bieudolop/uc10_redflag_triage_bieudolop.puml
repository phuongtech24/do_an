@startuml
skinparam defaultFontName "Times New Roman"
skinparam shadowing false
skinparam monochrome true
skinparam nodesep 60
skinparam ranksep 45
skinparam usecaseFontSize 14
title UC10 - Quản lý Cờ đỏ và điều phối lâm sàng
left to right direction

actor "Quản trị viên" as A1
actor "Bác sĩ" as A2
usecase "Form_RedFlagAlert" as B1
usecase "Form_TriagePanel" as B2
usecase "Form_OverrideAssign" as B3
usecase "ctrl_RedFlagDetect" as C1
usecase "ctrl_ClinicalTriage" as C2
usecase "ctrl_TherapistOverride" as C3
usecase "Ent_PatientProfile" as E1
usecase "Ent_LsasSubmission" as E2
usecase "Ent_UserMood" as E3
usecase "Ent_Journal" as E4
usecase "Ent_Appointment" as E5
usecase "Ent_TherapistProfile" as E6

B1 -[hidden]-> B2
B2 -[hidden]-> B3
B3 -[hidden]-> C1
C1 -[hidden]-> C2
C2 -[hidden]-> C3
C3 -[hidden]-> E1
E1 -[hidden]down-> E2
E2 -[hidden]down-> E3
E3 -[hidden]down-> E4
E4 -[hidden]down-> E5
E5 -[hidden]down-> E6

A2 -- B1
A2 -- B2
A1 -- B3
B1 -- C1
B2 -- C2
B3 -- C3
C1 -- E1
C1 -- E2
C1 -- E3
C1 -- E4
C2 -- E1
C2 -- E2
C2 -- E3
C2 -- E4
C2 -- E5
C3 -- E1
C3 -- E5
C3 -- E6
@enduml
