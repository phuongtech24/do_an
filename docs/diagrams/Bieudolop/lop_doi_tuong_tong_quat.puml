@startuml
skinparam defaultFontName "Times New Roman"
title Biểu đồ lớp đối tượng tổng quát ReConnect MindHealth

class User {
  +id: UUID
  +email: String
  +passwordHash: String
  +role: Role
  +isActive: Boolean
  +isAnonymous: Boolean
}

class GuestProfile {
  +id: UUID
  +nickname: String
  +avatarIcon: String
  +convertedToPatient: Boolean
}

class PatientProfile {
  +userId: UUID
  +nickName: String
  +anonymousModeEnabled: Boolean
  +realFullName: String
  +phoneNumber: String
  +currentLsasScore: Integer
  +isRedFlagActive: Boolean
  +currentProgramWeek: Integer
}

class TherapistProfile {
  +userId: UUID
  +fullName: String
  +phoneNumber: String
  +specialization: String
  +approvalStatus: ApprovalStatus
  +meetingLink: String
}

class LsasSituation {
  +id: UUID
  +situationNumber: Integer
  +text: String
  +situationGroup: LsasSituationGroup
}

class LsasSubmission {
  +id: UUID
  +submissionType: LsasSubmissionType
  +fearTotal: Integer
  +avoidanceTotal: Integer
  +totalScore: Integer
}

class LsasAnswer {
  +id: UUID
  +fearScore: Integer
  +avoidanceScore: Integer
  +totalScore: Integer
}

class PatientGoal {
  +id: UUID
  +goalType: PatientGoalType
  +description: String
  +status: PatientGoalStatus
}

class FearLadderItem {
  +id: UUID
  +baselineTotalScore: Integer
  +currentTotalScore: Integer
  +bucket: FearLadderBucket
  +ladderOrder: Integer
  +status: FearLadderStatus
}

class BehavioralExperiment {
  +id: UUID
  +status: BehavioralExperimentStatus
  +prediction: String
  +predictionBeliefBefore: Integer
  +predictionBeliefAfter: Integer
  +outcome: String
  +learning: String
}

class UserMood {
  +id: UUID
  +anxietyScore: Integer
  +sadnessScore: Integer
  +avoidanceUrgeScore: Integer
  +anticipatoryAnxietyScore: Integer
  +ruminationScore: Integer
  +safetyResponse: SafetyResponse
}

class Journal {
  +id: UUID
  +journalType: JournalType
  +contentEncrypted: Text
  +aiRiskScore: Integer
  +severityLevel: String
  +aiRiskReason: Text
}

class Appointment {
  +id: UUID
  +startAt: LocalDateTime
  +endAt: LocalDateTime
  +status: AppointmentStatus
  +purpose: AppointmentPurpose
  +meetingLink: String
}

class TherapistCredential {
  +id: UUID
  +fileName: String
  +status: String
}

class TherapistScheduleSlot {
  +id: UUID
  +slotDate: Date
  +startTime: Time
  +endTime: Time
}

class TherapistWeeklyScheduleSlot {
  +id: UUID
  +dayOfWeek: String
  +startTime: Time
  +endTime: Time
}

User "1" -- "0..1" GuestProfile
User "1" -- "0..1" PatientProfile
User "1" -- "0..1" TherapistProfile
TherapistProfile "1" -- "0..*" PatientProfile : quản lý >

PatientProfile "1" -- "0..*" LsasSubmission
LsasSubmission "1" -- "24" LsasAnswer
LsasAnswer "*" -- "1" LsasSituation

PatientProfile "1" -- "0..*" PatientGoal
PatientProfile "1" -- "0..*" FearLadderItem
FearLadderItem "*" -- "1" LsasSituation
PatientProfile "1" -- "0..*" BehavioralExperiment
FearLadderItem "1" -- "0..*" BehavioralExperiment

PatientProfile "1" -- "0..*" UserMood
PatientProfile "1" -- "0..*" Journal

PatientProfile "1" -- "0..*" Appointment
TherapistProfile "1" -- "0..*" Appointment

TherapistProfile "1" -- "0..*" TherapistCredential
TherapistProfile "1" -- "0..*" TherapistScheduleSlot
TherapistProfile "1" -- "0..*" TherapistWeeklyScheduleSlot

note bottom of Journal
Lưu dữ liệu AI cho Thought Record:
- aiRiskScore
- severityLevel
- aiRiskReason
end note

@enduml
