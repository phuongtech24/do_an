@startuml
skinparam defaultFontName "Times New Roman"
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho
title Biểu đồ lớp đối tượng tổng quát - ReConnect MindHealth

package "Tài khoản và hồ sơ" {
class User {
  +id: UUID
  +email: String
  +role: Role
  +isActive: Boolean
  +isAnonymous: Boolean
}

class GuestProfile {
  +nickname: String
  +avatarIcon: String
  +lsasDemoCompleted: Boolean
}

class PatientProfile {
  +nickName: String
  +anonymousModeEnabled: Boolean
  +realFullName: String
  +phoneNumber: String
  +currentLsasScore: Integer
  +currentProgramWeek: Integer
  +currentRiskScore: Integer
  +isRedFlagActive: Boolean
}

class TherapistProfile {
  +fullName: String
  +phoneNumber: String
  +specialization: String
  +approvalStatus: String
  +meetingLink: String
}

class TherapistCredential {
  +fileName: String
}
}

package "Đánh giá LSAS" {
class LsasSituation {
  +situationNumber: Integer
  +text: String
  +situationGroup: String
}

class LsasSubmission {
  +submissionType: String
  +fearTotal: Integer
  +avoidanceTotal: Integer
  +totalScore: Integer
}

class LsasAnswer {
  +fearScore: Integer
  +avoidanceScore: Integer
  +totalScore: Integer
}
}

package "Lộ trình trị liệu" {
class PatientGoal {
  +goalType: String
  +description: String
  +status: String
}

class FearLadderItem {
  +baselineTotalScore: Integer
  +currentTotalScore: Integer
  +bucket: String
  +ladderOrder: Integer
  +status: String
}

class BehavioralExperiment {
  +status: String
  +prediction: String
  +predictionBeliefBefore: Integer
  +predictionBeliefAfter: Integer
  +outcome: String
  +learning: String
}
}

package "Nhật ký và cảm xúc" {
class UserMood {
  +moodScore: Integer
  +anxietyScore: Integer
  +avoidanceUrgeScore: Integer
  +sadnessScore: Integer
  +anticipatoryAnxietyScore: Integer
  +postEventRuminationScore: Integer
  +safetyResponse: String
}

class Journal {
  +journalType: String
  +aiRiskScore: Integer
  +severityLevel: String
}
}

package "Telehealth" {
class Appointment {
  +startAt: DateTime
  +endAt: DateTime
  +status: String
  +purpose: String
}

class TherapistScheduleSlot {
  +slotDate: Date
  +startTime: Time
  +isOpen: Boolean
}

class TherapistWeeklyScheduleSlot {
  +dayOfWeek: String
  +startTime: Time
  +isOpen: Boolean
}
}

package "Trợ lý AI đồng hành" {
class AiChatSession {
  +sessionType: String
  +screenContext: String
  +status: String
  +startedAt: DateTime
  +endedAt: DateTime
}

class AiChatMessage {
  +senderType: String
  +messageText: Text
  +usedFallback: Boolean
  +relatedTopicCode: String
  +safetyEscalation: Boolean
  +intentDetected: String
}

class AiChatFeedback {
  +rating: Integer
  +feedbackText: Text
}
}

User "1" -- "0..1" GuestProfile
User "1" -- "0..1" PatientProfile
User "1" -- "0..1" TherapistProfile

TherapistProfile "1" -- "0..*" TherapistCredential
TherapistProfile "1" -- "0..*" PatientProfile : quản lý >

PatientProfile "1" -- "0..*" LsasSubmission
LsasSubmission "1" -- "24" LsasAnswer
LsasSituation "1" -- "0..*" LsasAnswer

PatientProfile "1" -- "0..*" PatientGoal
PatientProfile "1" -- "0..*" FearLadderItem
LsasSituation "1" -- "0..*" FearLadderItem
FearLadderItem "1" -- "0..*" BehavioralExperiment
PatientProfile "1" -- "0..*" BehavioralExperiment

PatientProfile "1" -- "0..*" UserMood
PatientProfile "1" -- "0..*" Journal

PatientProfile "1" -- "0..*" Appointment
TherapistProfile "1" -- "0..*" Appointment
TherapistProfile "1" -- "0..*" TherapistScheduleSlot
TherapistProfile "1" -- "0..*" TherapistWeeklyScheduleSlot

PatientProfile "1" -- "0..*" AiChatSession
AiChatSession "1" -- "0..*" AiChatMessage
AiChatMessage "1" -- "0..*" AiChatFeedback
PatientProfile "1" -- "0..*" AiChatFeedback

note right of PatientGoal
goalType:
COGNITIVE
EMOTIONAL
BEHAVIORAL
SOCIAL
end note

note right of FearLadderItem
bucket:
EASY
MEDIUM
HARD
EXTREME
end note

note right of Appointment
Unique:
(therapist_id, start_at)
(patient_id, start_at)
end note

@enduml
