@startuml
title Biểu đồ lớp - Chức năng đăng ký

class User {
  +id: UUID
  +email: String
  +passwordHash: String
  +role: Role
  +isActive: Boolean
}

class PatientProfile {
  +id: UUID
  +nickname: String
  +avatarIcon: String
  +anonymousModeEnabled: Boolean
}

class RegisterRequest {
  +email: String
  +password: String
  +confirmPassword: String
}

class RegisterResponse {
  +userId: UUID
  +email: String
  +message: String
}

class AuthController {
  +register(request)
}

class AuthService {
  +register(request)
}

enum Role {
  PATIENT
}

User "1" -- "0..1" PatientProfile
AuthController ..> AuthService
AuthController ..> RegisterRequest
AuthService ..> User
AuthService ..> PatientProfile
AuthService ..> RegisterResponse

@enduml
