@startuml
skinparam defaultFontName "Times New Roman"
skinparam shadowing false
skinparam monochrome true
skinparam nodesep 60
skinparam ranksep 45
skinparam usecaseFontSize 14
title UC01 - Quản lý Guest và chuyển đổi tài khoản
left to right direction

actor "Khách" as A
usecase "Form_GuestOnboarding" as B1
usecase "ctrl_GuestSession" as C1
usecase "Ent_GuestProfile" as E1
usecase "Ent_User" as E2
usecase "Ent_PatientProfile" as E3

B1 -[hidden]-> C1
C1 -[hidden]-> E1
E1 -[hidden]down-> E2
E2 -[hidden]down-> E3

A -- B1
B1 -- C1
C1 -- E1
C1 -- E2
C1 -- E3
@enduml
