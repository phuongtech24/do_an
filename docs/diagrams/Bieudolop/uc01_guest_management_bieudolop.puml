@startuml
skinparam defaultFontName "Times New Roman"
skinparam shadowing false
skinparam monochrome true
skinparam linetype ortho
skinparam nodesep 45
skinparam ranksep 40
title UC01 - Quản lý Guest và chuyển đổi tài khoản
left to right direction
actor "Khách" as A
boundary "Form_GuestOnboarding" as B1
boundary "Form_ConversionGate" as B2
control "ctrl_GuestSession" as C1
control "ctrl_ConversionGate" as C2
entity "Ent_GuestProfile" as E1
entity "Ent_User" as E2
entity "Ent_PatientProfile" as E3
B1 -[hidden]down-> B2
C1 -[hidden]down-> C2
E1 -[hidden]down-> E2
E2 -[hidden]down-> E3
A -- B1
A -- B2
B1 -- C1
B2 -- C2
C1 -- E1
C2 -- E1
C2 -- E2
C2 -- E3
@enduml
