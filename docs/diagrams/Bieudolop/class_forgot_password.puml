@startuml
title Biểu đồ lớp - Chức năng quên mật khẩu

class User {
  +id: UUID
  +email: String
  +passwordHash: String
  +isActive: Boolean
}

class PasswordResetToken {
  +id: UUID
  +token: String
  +expiresAt: DateTime
  +used: Boolean
}

class ForgotPasswordRequest {
  +email: String
}

class ResetPasswordRequest {
  +token: String
  +newPassword: String
  +confirmPassword: String
}

class AuthController {
  +forgotPassword(request)
  +resetPassword(request)
}

class AuthService {
  +requestPasswordReset(email)
  +resetPassword(request)
}

class MailService {
  +sendResetPasswordEmail(email, token)
}

User "1" -- "0..*" PasswordResetToken
AuthController ..> AuthService
AuthController ..> ForgotPasswordRequest
AuthController ..> ResetPasswordRequest
AuthService ..> User
AuthService ..> PasswordResetToken
AuthService ..> MailService

@enduml
