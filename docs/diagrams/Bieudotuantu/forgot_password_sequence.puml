@startuml
title Biểu đồ tuần tự - Chức năng quên mật khẩu

actor "Người dùng" as User
boundary "Màn hình quên mật khẩu" as ForgotPasswordView
control "AuthController" as AuthController
control "AuthService" as AuthService
control "MailService" as MailService
database "Cơ sở dữ liệu" as DB

User -> ForgotPasswordView : Nhập email quên mật khẩu
ForgotPasswordView -> AuthController : Gửi yêu cầu quên mật khẩu
AuthController -> AuthService : requestPasswordReset(email)
AuthService -> DB : Tìm tài khoản theo email
DB --> AuthService : Trả dữ liệu tài khoản

alt Email không tồn tại
  AuthService --> AuthController : Báo lỗi
  AuthController --> ForgotPasswordView : Trả thông báo lỗi
  ForgotPasswordView --> User : Hiển thị lỗi email không tồn tại
else Email hợp lệ
  AuthService -> AuthService : Tạo token đặt lại mật khẩu
  AuthService -> DB : Lưu token reset
  DB --> AuthService : Thành công
  AuthService -> MailService : Gửi email reset
  MailService --> AuthService : Đã gửi email
  AuthService --> AuthController : Thông báo kiểm tra email
  AuthController --> ForgotPasswordView : Yêu cầu nhập token và mật khẩu mới
  ForgotPasswordView --> User : Hiển thị form đặt lại mật khẩu

  User -> ForgotPasswordView : Nhập token, mật khẩu mới
  ForgotPasswordView -> AuthController : Gửi yêu cầu đặt lại mật khẩu
  AuthController -> AuthService : resetPassword(request)
  AuthService -> DB : Kiểm tra token reset
  DB --> AuthService : Trả token

  alt Token không hợp lệ hoặc hết hạn
    AuthService --> AuthController : Báo lỗi token
    AuthController --> ForgotPasswordView : Trả thông báo lỗi
    ForgotPasswordView --> User : Hiển thị lỗi token không hợp lệ
  else Token hợp lệ
    AuthService -> DB : Cập nhật mật khẩu mới
    AuthService -> DB : Vô hiệu hóa token reset
    DB --> AuthService : Thành công
    AuthService --> AuthController : Hoàn tất đặt lại mật khẩu
    AuthController --> ForgotPasswordView : Trả thông báo thành công
    ForgotPasswordView --> User : Thông báo đặt lại mật khẩu thành công
  end
end

@enduml