@startuml
skinparam defaultFontName "Times New Roman"
title Biểu đồ tuần tự - Đặt lịch và tư vấn từ xa

actor "Bệnh nhân" as Patient
boundary "Màn hình Đặt lịch" as BookingView
control "BoosterController" as Controller
control "BoosterServiceImpl" as Service
database "Cơ sở dữ liệu" as DB
actor "Bác sĩ" as Therapist

Patient -> BookingView : Mở màn hình đặt lịch
BookingView -> Controller : Lấy khung giờ trống
Controller -> Service : getAvailableSlots(patientId, date)
Service -> DB : Đọc therapist, schedule slot,\nappointment hiện có
DB --> Service : Danh sách slot khả dụng
Service --> Controller : AvailableSlotDto[]
Controller --> BookingView : Hiển thị khung giờ trống

Patient -> BookingView : Chọn slot và xác nhận
BookingView -> Controller : Gửi yêu cầu đặt lịch
Controller -> Service : bookAppointment(request)
Service -> DB : Kiểm tra lịch của Bác sĩ\ncùng thời điểm
DB --> Service : Kết quả kiểm tra

alt Slot của Bác sĩ đã bị đặt
  Service --> Controller : IllegalStateException
  Controller --> BookingView : Thông báo chọn slot khác
else Slot của Bác sĩ còn trống
  Service -> DB : Kiểm tra lịch của Bệnh nhân\ncùng thời điểm
  DB --> Service : Kết quả kiểm tra
  alt Bệnh nhân đã có lịch trùng giờ
    Service --> Controller : IllegalStateException
    Controller --> BookingView : Thông báo lịch bị trùng
  else Đặt lịch thành công
    Service -> DB : Lưu Appointment
    DB --> Service : Appointment đã lưu
    Service --> Controller : AppointmentDto
    Controller --> BookingView : Trả kết quả thành công
    BookingView --> Patient : Hiển thị xác nhận đặt lịch
    Patient -> BookingView : Mở lịch hẹn của tôi
    BookingView -> Controller : Lấy danh sách lịch hẹn
    Controller -> Service : getMyAppointments(patientId)
    Service -> DB : Đọc appointment của patient
    DB --> Service : Danh sách lịch hẹn
    Service --> Controller : AppointmentDto[]
    Controller --> BookingView : Hiển thị lịch hẹn
    Patient -> Therapist : Tham gia phiên tư vấn từ xa
  end
end
@enduml
