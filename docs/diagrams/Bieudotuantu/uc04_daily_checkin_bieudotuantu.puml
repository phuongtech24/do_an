@startuml
skinparam defaultFontName "Times New Roman"
actor "Bệnh nhân" as Patient
boundary "Màn hình Điểm danh" as CheckinView
control "MoodController" as Controller
control "MoodService" as Service
database "Cơ sở dữ liệu" as DB
Patient -> CheckinView : Chấm 5 chỉ số
CheckinView -> Controller : Gửi dữ liệu điểm danh
Controller -> Service : Lưu và kiểm tra an toàn
Service -> DB : Lưu mood check-in
DB --> Service : Đã lưu
alt Unsafe
  Service --> CheckinView : Bật Cờ đỏ
else Safe
  Service --> CheckinView : Lưu biểu đồ cá nhân
end
@enduml
