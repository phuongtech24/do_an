@startuml
skinparam defaultFontName "Times New Roman"
actor "Bệnh nhân" as Patient
boundary "Bảng Trợ lý AI" as AIView
control "AiGuideController" as Controller
control "AiGuideService" as Service
control "SafetyGuard" as Guard
control "GeminiClient" as Gemini
database "Cơ sở dữ liệu" as DB
Patient -> AIView : Chọn câu hỏi nhanh
AIView -> Controller : Gửi ngữ cảnh màn hình
Controller -> Service : Tìm câu trả lời phù hợp
Service -> DB : Đọc tri thức nội bộ
DB --> Service : Knowledge card
Service -> Guard : Kiểm tra an toàn
alt Cần Gemini
  Service -> Gemini : Sinh câu trả lời
  Gemini --> Service : Phản hồi
else Dùng mẫu sẵn
  Service --> Controller : Trả lời từ FAQ
end
Controller --> AIView : Hiển thị answer + suggestedActions
@enduml
