@startuml
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam defaultFontName Arial
skinparam usecase {
  BackgroundColor White
  BorderColor Black
}

title Biểu đồ Use case tổng quát theo miền chức năng

actor "Khách" as Guest
actor "Bệnh nhân" as Patient
actor "Bác sĩ" as Therapist
actor "Quản trị viên" as Admin

rectangle "Hệ thống ReConnect MindHealth" {
  usecase "Quản lý tài khoản,\nhồ sơ và danh tính ẩn danh" as UC01
  usecase "Đánh giá LSAS và\nphân luồng lâm sàng" as UC02
  usecase "Cảnh báo Cờ đỏ và\nđiều phối lâm sàng" as UC03
  usecase "Đặt lịch và tư vấn từ xa" as UC04
  usecase "Theo dõi lộ trình trị liệu" as UC05
  usecase "Thực hiện thử nghiệm hành vi" as UC06
  usecase "Điểm danh cảm xúc" as UC07
  usecase "Viết Nhật ký suy nghĩ" as UC08
  usecase "Sử dụng Trợ lý AI và\nhỗ trợ nhận thức" as UC09
}

Guest --> UC01
Guest --> UC02

Patient --> UC01
Patient --> UC02
Patient --> UC04
Patient --> UC05
Patient --> UC06
Patient --> UC07
Patient --> UC08
Patient --> UC09

Therapist --> UC03
Therapist --> UC04
Therapist --> UC05
Therapist --> UC06

Admin --> UC01
Admin --> UC03
Admin --> UC05

UC02 ..> UC01 : <<chuyển đổi>>
UC04 ..> UC05 : <<dữ liệu điều trị>>
UC06 ..> UC05 : <<theo nấc mở khóa>>
UC09 ..> UC08 : <<hỗ trợ nhận thức>>
@enduml
