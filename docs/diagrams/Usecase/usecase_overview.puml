@startuml
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam defaultFontName Arial

actor "Khách" as Guest
actor "Bệnh nhân" as Patient
actor "Bác sĩ" as Therapist
actor "Quản trị viên" as Admin
actor "Hệ thống" as System

rectangle "Hệ thống ReConnect MindHealth" {
  usecase "Chức năng của Khách" as UC_Guest
  usecase "Chức năng của Bệnh nhân" as UC_Patient
  usecase "Chức năng của Bác sĩ" as UC_Therapist
  usecase "Chức năng của Quản trị viên" as UC_Admin
  usecase "Chức năng tự động\ncủa hệ thống" as UC_System
}

Guest --> UC_Guest
Patient --> UC_Patient
Therapist --> UC_Therapist
Admin --> UC_Admin
System --> UC_System

UC_Guest ..> UC_Patient : <<chuyển đổi vai trò>>
UC_Patient ..> UC_System : <<kích hoạt dữ liệu>>
UC_Therapist ..> UC_System : <<sử dụng kết quả>>
UC_Admin ..> UC_System : <<giám sát/ghi đè>>
@enduml
