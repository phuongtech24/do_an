@startuml
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam defaultFontName Arial

actor "Hệ thống" as System

rectangle "Chức năng tự động của hệ thống" {
  usecase "Tự động phân luồng LSAS\nthành 4 mức" as S1
  usecase "Mức 1: Trấn an\nvà theo dõi nhẹ" as S1A
  usecase "Mức 2: Tự hỗ trợ\nvới công cụ CBT cơ bản" as S1B
  usecase "Mức 3: Lộ trình CBT 14 tuần\ncó Bác sĩ theo dõi" as S1C
  usecase "Mức 4: Ưu tiên lâm sàng,\nCờ đỏ và hàng chờ khẩn cấp" as S1D

  usecase "Tự động tạo Thang sợ hãi\nvà mở khóa bài tập" as S2
  usecase "Phát hiện nguy cơ qua\nSafety Gate và bật Cờ đỏ" as S3
  usecase "Gợi ý Nhật ký suy nghĩ\nhoặc Thẻ đối phó" as S4
  usecase "Chuyển sang duy trì\nvà nhắc lịch booster" as S5
  usecase "Hỗ trợ AI trong Nhật ký suy nghĩ\nvà Trợ lý AI đồng hành" as S6
}

System --> S1
System --> S2
System --> S3
System --> S4
System --> S5
System --> S6

S1 --> S1A : <<bao gồm>>
S1 --> S1B : <<bao gồm>>
S1 --> S1C : <<bao gồm>>
S1 --> S1D : <<bao gồm>>
@enduml
