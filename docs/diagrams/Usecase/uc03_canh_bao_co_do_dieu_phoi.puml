@startuml
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam defaultFontName Arial
skinparam usecase {
  BackgroundColor White
  BorderColor Black
}

title UC03 - Cảnh báo Cờ đỏ và điều phối lâm sàng

actor "Bác sĩ" as Therapist
actor "Quản trị viên" as Admin

rectangle "Hệ thống ReConnect MindHealth" {
  usecase "Cảnh báo Cờ đỏ và\nđiều phối lâm sàng" as UC03
  usecase "Xem dashboard ưu tiên" as UC031
  usecase "Xem ca Cờ đỏ" as UC032
  usecase "Theo dõi bệnh nhân\nnguy cơ cao" as UC033
  usecase "Xử lý hàng chờ phân loại\nlâm sàng" as UC034
  usecase "Ghi đè ghép cặp\nBác sĩ - Bệnh nhân" as UC035
  usecase "Xem thông tin phân loại\nlâm sàng" as UC036
}

Therapist --> UC03
Admin --> UC03

UC03 ..> UC031 : <<include>>
UC031 ..> UC032 : <<include>>
UC031 ..> UC033 : <<extend>>
UC03 ..> UC034 : <<include>>
UC03 ..> UC035 : <<include>>
UC032 ..> UC036 : <<include>>
@enduml
