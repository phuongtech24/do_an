@startuml
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam defaultFontName "Times New Roman"
skinparam usecase {
  BackgroundColor White
  BorderColor Black
}

title UC06 - Thực hành Thử nghiệm hành vi

actor "Bệnh nhân" as Patient
actor "Bác sĩ" as Therapist

rectangle "Hệ thống ReConnect MindHealth" {
  usecase "Thực hành Thử nghiệm hành vi" as UC06
  usecase "Thiết lập thử nghiệm\nhành vi" as UC061
  usecase "Thực hành thử nghiệm\nhành vi" as UC062
  usecase "Tổng kết thử nghiệm\nhành vi" as UC063
  usecase "Giao thử nghiệm\nhành vi" as UC064
}

Patient --> UC06
Therapist --> UC06

UC06 ..> UC061 : <<include>>
UC06 ..> UC062 : <<include>>
UC06 ..> UC063 : <<include>>
UC064 ..> UC06 : <<extend>>

@enduml
