@startuml
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam defaultFontName Arial
skinparam usecase {
  BackgroundColor White
  BorderColor Black
}

title UC02 - Đánh giá LSAS và phân luồng lâm sàng

actor "Khách" as Guest
actor "Bệnh nhân" as Patient

rectangle "Hệ thống ReConnect MindHealth" {
  usecase "Đánh giá LSAS và\nphân luồng lâm sàng" as UC02
  usecase "Thực hiện LSAS thử nghiệm" as UC021
  usecase "Thực hiện LSAS nền /\ntái đánh giá chính thức" as UC022
  usecase "Tính điểm LSAS" as UC023
  usecase "Xem kết quả phân luồng" as UC024
  usecase "Phân luồng mức 1:\nTrấn an" as UC025
  usecase "Phân luồng mức 2:\nTự hỗ trợ" as UC026
  usecase "Phân luồng mức 3:\nLộ trình CBT có bác sĩ" as UC027
  usecase "Phân luồng mức 4:\nƯu tiên lâm sàng" as UC028
  usecase "Thiết lập mục tiêu trị liệu" as UC029
  usecase "Lựa chọn bác sĩ phù hợp" as UC0210
}

Guest --> UC021
Patient --> UC022

UC021 ..> UC02 : <<extend>>
UC022 ..> UC02 : <<extend>>
UC02 ..> UC023 : <<include>>
UC02 ..> UC024 : <<include>>
UC024 ..> UC025 : <<extend>>
UC024 ..> UC026 : <<extend>>
UC024 ..> UC027 : <<extend>>
UC024 ..> UC028 : <<extend>>
UC029 ..> UC024 : <<extend>>
UC0210 ..> UC029 : <<extend>>
@enduml
