@startuml
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam defaultFontName Arial
skinparam usecase {
  BackgroundColor White
  BorderColor Black
}

title UC01 - Quản lý tài khoản, hồ sơ và danh tính ẩn danh

actor "Khách" as Guest
actor "Bệnh nhân" as Patient
actor "Quản trị viên" as Admin

rectangle "Hệ thống ReConnect MindHealth" {
  usecase "Quản lý tài khoản,\nhồ sơ và danh tính ẩn danh" as UC01
  usecase "Trải nghiệm chế độ ẩn danh" as UC011
  usecase "Chọn biệt danh" as UC012
  usecase "Chọn ảnh đại diện ảo" as UC013
  usecase "Đăng ký tài khoản" as UC014
  usecase "Đăng nhập" as UC015
  usecase "Đăng xuất" as UC016
  usecase "Quên mật khẩu" as UC017
  usecase "Liên kết email và mật khẩu" as UC018
  usecase "Khai báo hồ sơ y tế tối thiểu" as UC019
  usecase "Chuyển thành Bệnh nhân" as UC0110
  usecase "Quản lý hồ sơ cá nhân" as UC0111
  usecase "Quản lý hồ sơ y tế" as UC0112
  usecase "Bật/tắt chế độ ẩn danh" as UC0113
  usecase "Quản lý người dùng" as UC0114
  usecase "Quản lý tài khoản bác sĩ" as UC0115
}

Guest --> UC01
Patient --> UC01
Admin --> UC01

