@startuml
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam defaultFontName "Times New Roman"
skinparam usecase {
  BackgroundColor White
  BorderColor Black
}

title UC07 - Điểm danh cảm xúc

actor "Bệnh nhân" as Patient

rectangle "Hệ thống ReConnect MindHealth" {
  usecase "Điểm danh cảm xúc" as UC07
  usecase "Điểm danh cảm xúc\nhằng ngày" as UC071
  usecase "Chấm điểm 5 chỉ số\ncảm xúc" as UC072
  usecase "Xác nhận trạng thái\nan toàn" as UC073
  usecase "Điều hướng bước\nhỗ trợ tiếp theo" as UC074
  usecase "Mở hỗ trợ\nan toàn" as UC075
  usecase "Gợi ý viết\nNhật ký suy nghĩ" as UC076
  usecase "Gợi ý dùng\nThẻ đối phó" as UC077
}

Patient --> UC07

UC07 ..> UC071 : <<include>>
UC071 ..> UC072 : <<include>>
UC07 ..> UC074 : <<include>>
UC073 ..> UC071 : <<extend>>
UC075 ..> UC074 : <<extend>>
UC076 ..> UC074 : <<extend>>
UC077 ..> UC074 : <<extend>>

@enduml
