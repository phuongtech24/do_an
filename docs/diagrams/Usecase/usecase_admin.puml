@startuml
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam defaultFontName Arial

actor "Quản trị viên" as Admin

rectangle "Chức năng của Quản trị viên" {

  package "Quản lý người dùng" {
    usecase "Xem danh sách người dùng\nvà hồ sơ bệnh nhân" as A1
    usecase "Lọc, tìm kiếm\nvà phân trang" as A2
    usecase "Duyệt tài khoản bác sĩ" as A3
    usecase "Kích hoạt hoặc vô hiệu hóa\n tài khoản bác sĩ" as A4
  }

  package "Điều phối lâm sàng" {
    usecase "Ghi đè ghép cặp\nbác sĩ - bệnh nhân" as A5
    usecase "Xử lý hàng chờ phân loại lâm sàng" as A6
    usecase "Ưu tiên xử lý ca Cờ Đỏ" as A7
  }

  package "Quản trị điều trị" {
    usecase "Quản lý kho bài tập CBT" as A8
    usecase "Kích hoạt trạng thái tốt nghiệp" as A9
    usecase "Theo dõi giai đoạn duy trì\nvà tái khám" as A10
  }

  package "Theo dõi hệ thống" {
    usecase "Xem bảng điều khiển ưu tiên" as A11
    usecase "Theo dõi cảnh báo và nhắc nhở" as A12
  }
}

