                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"patient_lsas@reconnect.com\",\n  \"password\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let json = {};",
                  "try { json = pm.response.json(); } catch (e) {}",
                  "const token = json?.data?.accessToken || json?.data?.token;",
                  "const refresh = json?.data?.refreshToken;",
                  "const userId = json?.data?.user?.id || json?.data?.id;",
                  "if (token) pm.environment.set('access_token', token);",
                  "if (refresh) pm.environment.set('refresh_token', refresh);",
                  "if (userId) pm.environment.set('current_user_id', userId);"
                ]
              }
            }
          ]
        },
