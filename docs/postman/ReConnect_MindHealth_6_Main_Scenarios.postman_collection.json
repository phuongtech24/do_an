    {
      "name": "01 - Quan ly tai khoan, ho so va danh tinh an danh",
      "item": [
        {
          "name": "Register Anonymous Guest",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/auth/register-anonymous?deviceId={{device_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "register-anonymous"
              ],
              "query": [
                {
                  "key": "deviceId",
                  "value": "{{device_id}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let json = {};",
                  "try { json = pm.response.json(); } catch (e) {}",
                  "const guestId = json?.data?.user?.id || json?.data?.id;",
                  "const token = json?.data?.accessToken || json?.data?.token;",
                  "if (guestId) pm.environment.set('guest_id', guestId);",
                  "if (token) pm.environment.set('guest_access_token', token);"
                ]
              }
            }
          ]
        },
